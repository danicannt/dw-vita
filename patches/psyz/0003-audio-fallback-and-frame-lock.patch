+void Psyz_AudioFrame(int frames) {
+    // 44100 Hz / 59.94 Hz = 735.735 samples per NTSC frame
+    static unsigned long long acc;
+    short buf[4096];
+    int n;
+
+    if (!frame_locked || !is_audio_init) {
+        return;
+    }
+    acc += (unsigned long long)frames * PSYZ_SPU_SAMPLE_RATE * 1001;
+    n = (int)(acc / 60000);
+    acc -= (unsigned long long)n * 60000;
+    SDL_LockMutex(mutex);
+    while (n > 0) {
+        int batch = n > 2048 ? 2048 : n;
+        Psyz_SpuPullSamples(buf, batch);
+        // keep at most ~0.1 s queued; in turbo the rest is dropped
+        if (sdl_stream &&
+            SDL_GetAudioStreamQueued(sdl_stream) < PSYZ_SPU_SAMPLE_RATE / 10 * N_CHANNELS * (int)SAMPLE_SIZE) {
+            SDL_PutAudioStreamData(sdl_stream, buf, batch * N_CHANNELS * SAMPLE_SIZE);
+        }
+        n -= batch;
+    }
+    SDL_UnlockMutex(mutex);
+}
