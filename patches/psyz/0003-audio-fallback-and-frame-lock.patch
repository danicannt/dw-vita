+/**
+ * @brief Frame-locked audio: the SPU advances by one video frame's worth of
+ * samples per Psyz_AudioFrame call instead of when the device asks. Game logic
+ * that polls voice status then runs the same at any speed or without a device
+ * (record / replay). Call before Psyz_AudioInit.
+ */
+void Psyz_AudioSetFrameLocked(int on);
+
+/**
+ * @brief In frame-locked mode, render @p frames video frames of SPU output
+ * (44100 / 59.94 samples each) and queue them to the device, dropping what the
+ * device cannot take (turbo).
+ */
+void Psyz_AudioFrame(int frames);
