+#if defined(__vita__)
+    float_shaders = true;
+#else
+    float_shaders = SDL_getenv("PSYZ_GL_FLOAT_SHADERS") != NULL;
+#endif
+    if (float_shaders) {
+#if defined(__vita__)
+        vertShader = Init_CompileShaderWith(float_prologue_vs_vita,
+                                            float_vertex_shader_body,
+                                            GL_VERTEX_SHADER);
+        fragShader = Init_CompileShaderWith(float_prologue_fs_vita,
+                                            float_fragment_shader_body,
+                                            GL_FRAGMENT_SHADER);
+#else
+        vertShader = Init_CompileShaderWith(float_prologue_vs_core,
+                                            float_vertex_shader_body,
+                                            GL_VERTEX_SHADER);
+        fragShader = Init_CompileShaderWith(float_prologue_fs_core,
+                                            float_fragment_shader_body,
+                                            GL_FRAGMENT_SHADER);
+#endif
+        INFOF("using the float-only PS1 shaders");
+    } else {
+        vertShader = Init_CompileShader(vertex_shader_body, GL_VERTEX_SHADER);
+        fragShader =
+            Init_CompileShader(fragment_shader_body, GL_FRAGMENT_SHADER);
+    }
     GLuint program = glCreateProgram();
     glAttachShader(program, vertShader);
     glAttachShader(program, fragShader);
+    // the float shaders cannot say layout(location); same slots by name
+    glBindAttribLocation(program, 0, "pos");
+    glBindAttribLocation(program, 1, "tex");
+    glBindAttribLocation(program, 2, "color");
+    glBindAttribLocation(program, 3, "twin");
     glLinkProgram(program);
 
     int success = 0;
@@ -444,6 +506,25 @@ bool InitPlatform() {
         return false;
     }
 
+#if defined(__vita__)
+    sdl3_window = SDL_CreateWindow(
+        window_title, PSYZ_VITA_SCREEN_W, PSYZ_VITA_SCREEN_H, 0);
