diff --git a/psyz/src/platform/gl_float_shaders.h b/psyz/src/platform/gl_float_shaders.h
new file mode 100644
index 0000000..4426308
--- /dev/null
+++ b/psyz/src/platform/gl_float_shaders.h
@@ -0,0 +1,182 @@
+// Float-only variant of the sdl3_gl PS1 shaders, for GPUs without integer
+// arithmetic in shaders (the PS Vita's SGX543 through vitaGL). Same inputs
+// and same results as vertex_shader_body / fragment_shader_body: bit fields
+// come out with floor/mod, the 16-bit VRAM word is rebuilt from the RGBA5551
+// texel and palette indices are taken from it arithmetically.
+//
+// The bodies are shared: the prologue picks the dialect (GLSL 330 core on
+// desktop, vitaGL's GLSL 1.x on the Vita) through these macros
+//   ATTR      vertex input        VARY      vertex->fragment varying
+//   TEX2D     texture sampling    FragColor fragment output
+// and PSYZ_NO_DITHER drops the dither pattern (it needs gl_FragCoord tables).
+#ifndef PSYZ_GL_FLOAT_SHADERS_H
+#define PSYZ_GL_FLOAT_SHADERS_H
+
+static const char float_prologue_vs_core[] = {
+    "#version 330 core\n"
+    "#define ATTR in\n"
+    "#define VARY out\n"};
+static const char float_prologue_fs_core[] = {
+    "#version 330 core\n"
+    "#define VARY in\n"
+    "#define TEX2D texture\n"
+    "out vec4 FragColor;\n"};
+static const char float_prologue_vs_vita[] = {
+    "#define ATTR attribute\n"
+    "#define VARY varying\n"};
+static const char float_prologue_fs_vita[] = {
+    "#define VARY varying\n"
+    "#define TEX2D texture2D\n"
+    "#define FragColor gl_FragColor\n"
+    "#define PSYZ_NO_DITHER\n"};
+
+static const char float_vertex_shader_body[] = {
+    "ATTR vec2 pos;\n"
+    "ATTR vec4 tex;\n"   // u, v, clut, tpage word (with the TPAGE_* flags)
+    "ATTR vec4 color;\n" // normalized RGBA8
+    "ATTR vec4 twin;\n"  // texture window: and.x, and.y, or.x, or.y
+    "uniform vec2 drawOffset;\n"
+    "uniform vec2 halfPixel;\n"
+    "VARY vec4 vColor;\n"
+    "VARY vec2 vUV;\n"
+    // x mode (0 untextured, 1 16-bit, 2 indexed), y texels per VRAM pixel,
+    // z palette size, w dither
+    "VARY vec4 vMode;\n"
+    "VARY vec4 vPage;\n" // xy texture page origin, zw palette origin
+    "VARY vec4 vTwin;\n"
+    "VARY float vAbr;\n" // semi-transparency mode
+    "float bit(float word, float value) {\n"
+    "    return mod(floor(word / value), 2.0);\n"
+    "}\n"
+    "void main() {\n"
+    "    float word = tex.w;\n"
+    "    vec2 shift = bit(word, 8192.0) > 0.5 ? halfPixel : vec2(0.0);\n"
+    "    float x = ((pos.x + drawOffset.x + shift.x) / (1024.0 / 2.0)) - 1.0;\n"
+    "    float y = ((pos.y + drawOffset.y + shift.y) / (512.0 / 2.0)) - 1.0;\n"
+    "    gl_Position = vec4(x, y, 0.0, 1.0);\n"
+    "    vColor = color;\n"
+    "    float tpage = mod(word, 512.0);\n"
+    "    vUV = tex.xy + shift - halfPixel;\n"
+    "    float depth = mod(floor(tpage / 128.0), 4.0);\n"
+    "    vMode = vec4(0.0, 1.0, 1.0, bit(word, 16384.0));\n"
+    "    if (word < 32768.0) {\n"
+    "        vColor.rgb *= 2.0;\n"
+    "        if (depth >= 2.0) {\n"
+    "            vMode.x = 1.0;\n"
+    "        } else if (depth >= 1.0) {\n"
+    "            vMode.xyz = vec3(2.0, 2.0, 256.0);\n" // 8-bit indexed
+    "        } else {\n"
+    "            vMode.xyz = vec3(2.0, 4.0, 16.0);\n" // 4-bit indexed
+    "        }\n"
+    "    }\n"
+    "    vPage = vec4(mod(tpage, 16.0) * 64.0,\n"
+    "                 mod(floor(tpage / 16.0), 2.0) * 256.0,\n"
+    "                 mod(tex.z, 64.0) * 16.0, floor(tex.z / 64.0));\n"
+    "    vTwin = twin;\n"
+    "    vAbr = mod(floor(tpage / 32.0), 4.0);\n"
+    "}\n"};
+
+static const char float_fragment_shader_body[] = {
+    "VARY vec4 vColor;\n"
+    "VARY vec2 vUV;\n"
+    "VARY vec4 vMode;\n"
+    "VARY vec4 vPage;\n"
+    "VARY vec4 vTwin;\n"
+    "VARY float vAbr;\n"
+    "uniform sampler2D texVram;\n"
+    "\n"
+    "vec4 fetch(vec2 p) {\n"
+    "    return TEX2D(texVram, (p + 0.5) / vec2(1024.0, 512.0));\n"
+    "}\n"
+    // a & m for 0..255 values, one bit at a time
+    "float and8(float a, float m) {\n"
+    "    float r = 0.0;\n"
+    "    float p = 1.0;\n"
+    "    for (int i = 0; i < 8; i++) {\n"
+    "        r += p * mod(floor(a / p), 2.0) * mod(floor(m / p), 2.0);\n"
+    "        p *= 2.0;\n"
+    "    }\n"
+    "    return r;\n"
+    "}\n"
+    "vec2 resolveTexel() {\n"
+    "    vec2 t = clamp(floor(vUV + 1.0 / 512.0), vec2(0.0), vec2(255.0));\n"
+    "    vec4 w = floor(vTwin + 0.5);\n"
+    // the window keeps the high bits and replaces the low ones (disjoint)
+    "    if (w.x < 255.0 || w.y < 255.0 || w.z > 0.0 || w.w > 0.0) {\n"
+    "        t = vec2(and8(t.x, w.x), and8(t.y, w.y)) + w.zw;\n"
+    "    }\n"
+    "    return t;\n"
+    "}\n"
+    "#ifndef PSYZ_NO_DITHER\n"
+    "float ditherOffset() {\n"
+    "    float dx = mod(floor(gl_FragCoord.x), 4.0);\n"
+    "    float dy = mod(floor(gl_FragCoord.y), 4.0);\n"
+    "    vec4 row = dy < 0.5 ? vec4(-4.0, +0.0, -3.0, +1.0)\n"
+    "             : dy < 1.5 ? vec4(+2.0, -2.0, +3.0, -1.0)\n"
+    "             : dy < 2.5 ? vec4(-3.0, +1.0, -4.0, +0.0)\n"
+    "                        : vec4(+3.0, -1.0, +2.0, -2.0);\n"
+    "    return dot(row, vec4(equal(vec4(dx), vec4(0.0, 1.0, 2.0, 3.0))));\n"
+    "}\n"
+    "#endif\n"
+    "vec3 applyDither(vec3 c) {\n"
+    "#ifndef PSYZ_NO_DITHER\n"
+    "    if (vMode.w > 0.5) {\n"
+    "        vec3 c8 = c * 255.0 + ditherOffset();\n"
+    "        return clamp(floor(c8 / 8.0), 0.0, 31.0) / 31.0;\n"
+    "    }\n"
+    "#endif\n"
+    "    return c;\n"
+    "}\n"
+    "\n"
+    "void main() {\n"
+    "    float mode = floor(vMode.x + 0.5);\n"
+    "    bool dither = vMode.w > 0.5;\n"
+    "    vec4 texColor;\n"
+    "    if (mode < 0.5) {\n"
+    "        texColor = vec4(1.0, 1.0, 1.0, 2.0);\n"
+    "    } else if (mode < 1.5) {\n"
+    "        texColor = fetch(vPage.xy + resolveTexel());\n"
+    "    } else {\n"
+    "        float perPixel = floor(vMode.y + 0.5);\n"
+    "        float size = floor(vMode.z + 0.5);\n"
+    "        vec2 t = resolveTexel();\n"
+    "        vec4 c = fetch(vPage.xy + vec2(floor(t.x / perPixel), t.y));\n"
+    "        float word = floor(c.r * 31.0 + 0.5)\n"
+    "                   + floor(c.g * 31.0 + 0.5) * 32.0\n"
+    "                   + floor(c.b * 31.0 + 0.5) * 1024.0\n"
+    "                   + floor(c.a + 0.5) * 32768.0;\n"
+    "        float sub = mod(t.x, perPixel);\n"
+    "        float index = mod(floor(word / pow(size, sub)), size);\n"
+    "        texColor = fetch(vPage.zw + vec2(index, 0.0));\n"
+    "    }\n"
+    "    if (texColor == vec4(0.0)) {\n"
+    "        FragColor = vec4(0.0);\n"
+    "        return;\n"
+    "    }\n"
+    "    bool isSemiTrans = vColor.a < 0.75;\n"
+    "    bool colorSemiTrans = texColor.a > 0.0;\n"
+    "    vec3 modColor;\n"
+    "    if (mode < 0.5) {\n"
+    "        modColor = texColor.rgb * vColor.rgb;\n"
+    "    } else {\n"
+    "        vec3 tex5 = floor(texColor.rgb * 31.0 + 0.5);\n"
+    "        vec3 col8 = min(floor(vColor.rgb * 127.5 + 0.5), vec3(255.0));\n"
+    "        vec3 prod8 = min(tex5 * col8 / 16.0, vec3(255.0));\n"
+    "        modColor = dither ? prod8 / 255.0 : floor(prod8 / 8.0) / 31.0;\n"
+    "    }\n"
+    "    modColor = applyDither(modColor);\n"
+    "    if (colorSemiTrans && isSemiTrans) {\n"
+    "        float abr = floor(vAbr + 0.5);\n"
+    "        if (abr < 0.5) {\n"
+    "            FragColor = vec4(modColor * 0.5, 0.5);\n"
+    "        } else if (abr < 2.5) {\n"
+    "            FragColor = vec4(modColor, 0.0);\n" // additive / subtractive
+    "        } else {\n"
+    "            FragColor = vec4(modColor * 0.25, 0.0);\n"
+    "        }\n"
+    "    } else {\n"
+    "        FragColor = vec4(modColor, 1.0);\n"
+    "    }\n"
+    "}\n"};
+
+#endif
