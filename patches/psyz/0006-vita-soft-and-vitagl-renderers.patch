+// ---- timing (always on the Vita, PSYZ_GL_PERF=1 elsewhere) -----------------
+// Every 120 presents: calls per second and CPU time per second of each VRAM
+// operation. Readbacks (StoreImage) and syncs between the draw target and the
+// sampled VRAM wait for the GPU, so they also show GPU stalls.
+enum {
+    PERF_FLUSH, PERF_CLEAR, PERF_LOAD, PERF_STORE, PERF_MOVE,
+    PERF_SYNC_TO_DRAW, PERF_SYNC_TO_VRAM, PERF_PRESENT, PERF_COUNT
+};
+static const char* const perf_names[PERF_COUNT] = {
+    "flush", "clear", "load", "store", "move", "sync>draw", "sync>vram",
+    "present"};
+static int perf_on = -1;
+static Uint64 perf_ticks[PERF_COUNT];
+static unsigned perf_calls[PERF_COUNT];
+
+static bool PerfOn(void) {
+    if (perf_on < 0) {
+#if defined(__vita__)
+        perf_on = 1;
+#else
+        perf_on = SDL_getenv("PSYZ_GL_PERF") != NULL;
+#endif
+    }
+    return perf_on != 0;
+}
+#define PERF_WRAP(id, call)                                                    \
+    do {                                                                       \
+        if (!PerfOn()) {                                                       \
+            call;                                                              \
+            break;                                                             \
+        }                                                                      \
+        Uint64 t0_ = SDL_GetPerformanceCounter();                              \
+        call;                                                                  \
+        perf_ticks[id] += SDL_GetPerformanceCounter() - t0_;                   \
+        perf_calls[id]++;                                                      \
+    } while (0)
+
+static void SyncNativeVramToScaled(int x, int y, int w, int h) {
+    PERF_WRAP(PERF_SYNC_TO_DRAW, SyncNativeVramToScaled_impl(x, y, w, h));
+}
+static void SyncScaledVramToNative(void) {
+    PERF_WRAP(PERF_SYNC_TO_VRAM, SyncScaledVramToNative_impl());
+}
+void Draw_ClearImage(PS1_RECT* rect, u_char r, u_char g, u_char b) {
+    PERF_WRAP(PERF_CLEAR, Draw_ClearImage_impl(rect, r, g, b));
+}
+void Draw_LoadImage(PS1_RECT* rect, u_long* p) {
+    PERF_WRAP(PERF_LOAD, Draw_LoadImage_impl(rect, p));
+}
+void Draw_StoreImage(PS1_RECT* rect, u_long* p) {
+    PERF_WRAP(PERF_STORE, Draw_StoreImage_impl(rect, p));
+}
+void Draw_MoveImage(PS1_RECT* rect, unsigned int x, unsigned int y) {
+    PERF_WRAP(PERF_MOVE, Draw_MoveImage_impl(rect, x, y));
+}
+void Draw_FlushBuffer(void) { PERF_WRAP(PERF_FLUSH, Draw_FlushBuffer_impl()); }
+
+static void PlatformBackend_Present(void) {
+    static Uint64 last;
+    PERF_WRAP(PERF_PRESENT, PlatformBackend_Present_impl());
+    if (!PerfOn() || perf_calls[PERF_PRESENT] < 120) {
+        return;
+    }
+    Uint64 now = SDL_GetPerformanceCounter();
+    double freq = (double)SDL_GetPerformanceFrequency();
+    if (last != 0) {
+        double span = (double)(now - last) / freq;
+        char line[512];
+        int n = SDL_snprintf(line, sizeof(line), "perf: %.1f presents/s |",
+                             perf_calls[PERF_PRESENT] / span);
+        for (int i = 0; i < PERF_COUNT && n < (int)sizeof(line); i++) {
+            n += SDL_snprintf(line + n, sizeof(line) - n, " %s %.0f/s %.1fms/s",
+                              perf_names[i], perf_calls[i] / span,
+                              perf_ticks[i] * 1000.0 / freq / span);
+        }
+        INFOF("%s", line);
+    }
+    SDL_memset(perf_ticks, 0, sizeof(perf_ticks));
+    SDL_memset(perf_calls, 0, sizeof(perf_calls));
+    last = now;
+}
