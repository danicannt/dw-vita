+        ERRORF("SDL_CreateWindow: %s", SDL_GetError());
+        return false;
+    }
+    vglSetupRuntimeShaderCompiler(SHARK_OPT_UNSAFE, GL_TRUE, GL_FALSE, GL_TRUE);
+    if (!vglInitExtended(0, PSYZ_VITA_SCREEN_W, PSYZ_VITA_SCREEN_H,
+                         8 * 1024 * 1024, SCE_GXM_MULTISAMPLE_NONE)) {
+        ERRORF("vglInitExtended failed");
+        return false;
+    }
+    vglWaitVblankStart(GL_TRUE);
+    glContext = (SDL_GLContext)1; // vitaGL has no context object; mark it up
+    use_gles = true;
+    INFOF("vitaGL initialized, renderer: %s",
+          (const char*)glGetString(GL_RENDERER));
