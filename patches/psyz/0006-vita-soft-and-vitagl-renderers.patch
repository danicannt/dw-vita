diff --git a/psyz/src/platform/sdl3_audio.c b/psyz/src/platform/sdl3_audio.c
index 1471d5f..67675c8 100644
--- a/psyz/src/platform/sdl3_audio.c
+++ b/psyz/src/platform/sdl3_audio.c
@@ -21,7 +21,22 @@ static void SDLCALL audio_callback(void* userdata, SDL_AudioStream* stream,
 
     int num_frames = additional_amount / (N_CHANNELS * SAMPLE_SIZE);
     short buf[4096] = {0};
+    // PSYZ_SOFT_PERF=1 (always on on the Vita): log how much of real time
+    // the SPU emulation takes, every 5 s of audio
+    static int perf = -1;
+    static Uint64 spu_time, spu_frames;
+    Uint64 t0 = 0;
+    if (perf < 0) {
+#if defined(__vita__)
+        perf = 1;
+#else
+        perf = SDL_getenv("PSYZ_SOFT_PERF") != NULL;
+#endif
+    }
     SDL_LockMutex(mutex);
+    if (perf) {
+        t0 = SDL_GetPerformanceCounter();
+    }
     while (num_frames > 0) {
         int batch = num_frames;
         if (batch > 2048)
@@ -29,6 +44,16 @@ static void SDLCALL audio_callback(void* userdata, SDL_AudioStream* stream,
         Psyz_SpuPullSamples(buf, batch);
         SDL_PutAudioStreamData(stream, buf, batch * N_CHANNELS * SAMPLE_SIZE);
         num_frames -= batch;
+        spu_frames += batch;
+    }
+    if (perf) {
+        spu_time += SDL_GetPerformanceCounter() - t0;
+        if (spu_frames >= 44100 * 5) {
+            double ms = spu_time * 1000.0 / (double)SDL_GetPerformanceFrequency();
+            INFOF("perf: SPU %.1f%% of one core (%.1f ms per 5 s of audio)",
+                  ms / 50.0, ms);
+            spu_time = spu_frames = 0;
+        }
     }
     SDL_UnlockMutex(mutex);
 }
