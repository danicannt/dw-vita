new file mode 100644
index 0000000..3118942
--- /dev/null
+++ b/psyz/src/platform/sdl3_soft.c
@@ -0,0 +1,440 @@
+// Software renderer: the GPU is emulated on the CPU by the rasterizer in
+// sdl3_software.c and the visible part of VRAM is handed to SDL's 2D
+// renderer once per frame, only to be scaled to the window. It needs no
+// OpenGL, no shaders and no SDL_GPU, which makes it the first renderer for
+// targets without them (PS Vita, through SDL3's GXM renderer).
+//
+// Internal resolution is always 1x: the rasterizer draws at the PS1's own
+// resolution, so it looks and behaves like the console.
+#include <psyz.h>
+#include <psyz/overlay.h>
+#include <stdbool.h>
+#include <stdlib.h>
+#include <string.h>
+#include <libetc.h>
+#include "../internal.h"
+#include <SDL3/SDL.h>
+
+#include "sdl3_common.h"
+#include "rasterizer.h"
+#include "rgb24.h"
+
+static const DrawBackend* const raster = &software_rasterizer;
+
+static SDL_Renderer* renderer;
+static SDL_Texture* screen_tex;  // 15-bit display area (PS1 BGR555 layout)
+static SDL_Texture* rgb24_tex;   // 24-bit display area (MDEC movies)
+static int screen_tex_w, screen_tex_h;
+static int rgb24_tex_w, rgb24_tex_h;
+
+static bool display_rgb24;
+static SDL_Point display_area = {0, 0};
+static SDL_Point display_size = {256, 240};
+static SDL_Point draw_area_start = {0, 0};
+static SDL_Point draw_area_end = {VRAM_W - 1, VRAM_H - 1};
+
+// VRAM changed since the picture was last uploaded (a game paced with
+// VSync(3) presents each frame three times; upload it once)
+static bool vram_dirty = true;
+
+// PSYZ_SOFT_PERF=1 (always on on the Vita): every 120 presents log the frame
+// rate and where the time goes, raster = drawing primitives and VRAM
+// transfers, upload = handing the picture to SDL, other = everything else
+// between presents minus the vsync wait (game logic, GTE, ...)
+static bool perf_enabled;
+static Uint64 perf_raster, perf_upload, perf_wait, perf_last;
+static unsigned perf_presents, perf_uploads;
+
+static inline Uint64 PerfNow(void) { return SDL_GetPerformanceCounter(); }
+#define PERF_BEGIN Uint64 perf_t0 = perf_enabled ? PerfNow() : 0
+#define PERF_END(acc) do { if (perf_enabled) acc += PerfNow() - perf_t0; } while (0)
+
+bool InitPlatform() {
+    if (is_platform_initialized) {
+        return is_platform_init_successful;
+    }
+    is_platform_initialized = true;
+
+    if (!SDL_Init(SDL_INIT_VIDEO)) {
+        ERRORF("SDL_Init: %s", SDL_GetError());
+        return false;
+    }
+    sdl3_window = SDL_CreateWindow(
+        window_title, DEFAULT_FRONT_W, DEFAULT_FRONT_H,
+        SDL_WINDOW_HIDDEN | SDL_WINDOW_RESIZABLE |
+            SDL_WINDOW_HIGH_PIXEL_DENSITY);
+    if (!sdl3_window) {
+        ERRORF("SDL_CreateWindow: %s", SDL_GetError());
+        return false;
+    }
+    renderer = SDL_CreateRenderer(sdl3_window, NULL);
+    if (!renderer) {
+        ERRORF("SDL_CreateRenderer: %s", SDL_GetError());
+        return false;
+    }
+    INFOF("software renderer, presenting through SDL renderer '%s'",
+          SDL_GetRendererName(renderer));
+
+    SoftwareRasterizer_Reset();
+    Sdl3Common_TimingInit();
+#if defined(__vita__)
+    perf_enabled = true;
+#else
+    perf_enabled = SDL_getenv("PSYZ_SOFT_PERF") != NULL;
+#endif
+    is_platform_init_successful = true;
+    return true;
+}
+
+static bool PlatformBackend_SetDriverVsync(bool enable) {
+    return renderer && SDL_SetRenderVSync(renderer, enable ? 1 : 0) && enable;
+}
+
+// a streaming texture of at least w x h, recreated when the size changes
+static SDL_Texture* EnsureTexture(SDL_Texture** tex, int* tw, int* th,
+                                  SDL_PixelFormat format, int w, int h) {
+    if (*tex && *tw == w && *th == h) {
+        return *tex;
+    }
+    if (*tex) {
+        SDL_DestroyTexture(*tex);
+    }
+    *tex = SDL_CreateTexture(
+        renderer, format, SDL_TEXTUREACCESS_STREAMING, w, h);
+    if (!*tex) {
+        ERRORF("SDL_CreateTexture: %s", SDL_GetError());
+        return NULL;
+    }
+    SDL_SetTextureScaleMode(*tex, SDL_SCALEMODE_NEAREST);
+    *tw = w;
+    *th = h;
+    return *tex;
+}
+
+static SDL_Texture* PrepareScreen(void) {
+    int x = CLAMP(display_area.x, 0, VRAM_W - 1);
+    int y = CLAMP(display_area.y, 0, VRAM_H - 1);
+    int w = CLAMP(display_size.x, 1, VRAM_W - x);
+    int h = CLAMP(display_size.y, 1, VRAM_H - y);
+    const u16* vram = SoftwareRasterizer_GetVram();
+
+    if (display_rgb24) {
+        unsigned char* rgb = AllocRgb24Region(
+            display_area.x, display_area.y, display_size.x, display_size.y);
+        SDL_Texture* tex =
+            EnsureTexture(&rgb24_tex, &rgb24_tex_w, &rgb24_tex_h,
+                          SDL_PIXELFORMAT_RGB24, display_size.x, display_size.y);
+        if (rgb && tex) {
+            SDL_UpdateTexture(tex, NULL, rgb, display_size.x * 3);
+        }
+        free(rgb);
+        return tex;
+    }
+    // PS1 VRAM is R in bits 0-4, G 5-9, B 10-14: SDL's XBGR1555, row pitch
+    // of the whole VRAM, so the display area uploads without a copy
+    SDL_Texture* tex = EnsureTexture(&screen_tex, &screen_tex_w, &screen_tex_h,
+                                     SDL_PIXELFORMAT_XBGR1555, w, h);
+    if (tex) {
+        SDL_UpdateTexture(
+            tex, NULL, vram + (size_t)y * VRAM_W + x, VRAM_W * sizeof(u16));
+    }
+    return tex;
+}
+
+static void PlatformBackend_Present(void) {
+    if (!sdl3_window && !InitPlatform()) {
+        return;
+    }
+    if (Sdl3Common_IsInBackground()) {
+        finish_time = SDL_GetPerformanceCounter();
+        return;
+    }
+    SDL_SetRenderDrawColor(renderer, 0, 0, 0, 255);
+    SDL_RenderClear(renderer);
+    if (disp_on) {
+        SDL_Texture* tex = display_rgb24 ? rgb24_tex : screen_tex;
+        if (vram_dirty || !tex) {
+            PERF_BEGIN;
+            tex = PrepareScreen();
+            vram_dirty = false;
+            perf_uploads++;
+            PERF_END(perf_upload);
+        }
+        WndSize win = {0, 0};
+        SDL_GetRenderOutputSize(renderer, &win.w, &win.h);
+        SDL_Rect dst = FitGameToWindow(
+            GetCurrentGameAspectRatio(display_size.x, display_size.y), win);
+        SDL_FRect fdst = {(float)dst.x, (float)dst.y, (float)dst.w,
+                          (float)dst.h};
+        if (tex) {
+            SDL_RenderTexture(renderer, tex, NULL, &fdst);
+        }
+    }
+    if (overlay_frame_cb) {
+        overlay_frame_cb();
+    }
+    finish_time = SDL_GetPerformanceCounter();
+    {
+        PERF_BEGIN;
+        SDL_RenderPresent(renderer);
+        PERF_END(perf_wait);
+    }
+    if (perf_enabled) {
+        Uint64 now = PerfNow();
+        if (perf_last == 0) {
+            perf_last = now;
+        } else if (++perf_presents == 120) {
+            double f = 1000.0 / (double)SDL_GetPerformanceFrequency();
+            double span = (double)(now - perf_last) * f;
+            double frames = perf_uploads ? perf_uploads : 1;
+            INFOF("perf: %.1f presents/s, %.1f new frames/s | per frame ms: "
+                  "raster %.2f upload %.2f present+vsync %.2f other %.2f",
+                  perf_presents * 1000.0 / span, perf_uploads * 1000.0 / span,
+                  perf_raster * f / frames, perf_upload * f / frames,
+                  perf_wait * f / frames,
+                  (span - (perf_raster + perf_upload + perf_wait) * f) / frames);
+            perf_presents = perf_uploads = 0;
+            perf_raster = perf_upload = perf_wait = 0;
+            perf_last = now;
+        }
+    }
+}
+
+static void QuitPlatform(void) {
+    Sdl3Common_Shutdown();
+    if (overlay_destroy_cb) {
+        overlay_destroy_cb();
+    }
+    if (screen_tex) {
+        SDL_DestroyTexture(screen_tex);
+        screen_tex = NULL;
+    }
+    if (rgb24_tex) {
+        SDL_DestroyTexture(rgb24_tex);
+        rgb24_tex = NULL;
+    }
+    if (renderer) {
+        SDL_DestroyRenderer(renderer);
+        renderer = NULL;
+    }
+    if (sdl3_window) {
+        SDL_DestroyWindow(sdl3_window);
+        sdl3_window = NULL;
+        is_window_visible = false;
+    }
+    SDL_Quit();
+    is_platform_initialized = false;
+    is_platform_init_successful = false;
+}
+
+void ResetPlatform(void) {
+    free(vram_convert_buf);
+    vram_convert_buf = NULL;
+    vram_convert_cap = 0;
+    QuitPlatform();
+}
+
+// ---- video API ------------------------------------------------------------
+
+static unsigned char* AllocRgb888Region(int x, int y, int w, int h) {
+    const u16* vram = SoftwareRasterizer_GetVram();
+    unsigned char* out = malloc((size_t)w * h * 3);
+
+    if (!out) {
+        return NULL;
+    }
+    for (int row = 0; row < h; row++) {
+        for (int col = 0; col < w; col++) {
+            int vx = CLAMP(x + col, 0, VRAM_W - 1);
+            int vy = CLAMP(y + row, 0, VRAM_H - 1);
+            u16 c = vram[vy * VRAM_W + vx];
+            unsigned char* p = out + ((size_t)row * w + col) * 3;
+            p[0] = color_5to8(c & 31);
+            p[1] = color_5to8((c >> 5) & 31);
+            p[2] = color_5to8((c >> 10) & 31);
+        }
+    }
+    return out;
+}
+
+unsigned char* Psyz_VideoAllocCapturedFrame(int* w, int* h) {
+    *w = display_size.x;
+    *h = display_size.y;
+    return display_rgb24
+               ? AllocRgb24Region(display_area.x, display_area.y, *w, *h)
+               : AllocRgb888Region(display_area.x, display_area.y, *w, *h);
+}
+
+unsigned char* Psyz_VideoAllocVramDump(int* w, int* h) {
+    *w = VRAM_W;
+    *h = VRAM_H;
+    return AllocRgb888Region(0, 0, VRAM_W, VRAM_H);
+}
+
+unsigned Psyz_VideoGetInternalResolution(void) { return 1; }
+
+int Psyz_VideoSetInternalResolution(unsigned multiplier) {
+    if (multiplier != 1) {
+        WARNF("the software renderer draws at 1x only");
+        return -1;
+    }
+    return 0;
+}
+
+int Psyz_VideoSetPixelFilter(unsigned block) {
+    if (block) {
+        WARNF("pixel filter needs the sdl3_gl renderer");
+    }
+    return block ? -1 : 0;
+}
+
+unsigned Psyz_VideoGetPixelFilter(void) { return 0; }
+
+// ---- display --------------------------------------------------------------
+
+static void ApplyDisplayPendingChanges(void) {
+    if (!sdl3_window && !InitPlatform()) {
+        return;
+    }
+    if (!is_window_visible) {
+        SetWindowSizeInPixels(DEFAULT_FRONT_W, DEFAULT_FRONT_H);
+        SDL_ShowWindow(sdl3_window);
+        is_window_visible = true;
+    }
+    if (cur_disp_horiz != set_disp_horiz || cur_disp_vert != set_disp_vert) {
+        cur_disp_horiz = set_disp_horiz;
+        cur_disp_vert = set_disp_vert;
+    }
+}
+
+void Draw_Reset() { NOT_IMPLEMENTED; }
+
+void Draw_DisplayEnable(unsigned int on) {
+    disp_on = on;
+    if (on) {
+        ApplyDisplayPendingChanges();
+    }
+}
+
+void Draw_DisplayArea(unsigned int x, unsigned int y) {
+    vram_dirty = true;
+    display_area.x = (int)x;
+    display_area.y = (int)y;
+    ApplyDisplayPendingChanges();
+}
+
+void Draw_DisplayHorizontalRange(unsigned int start, unsigned int end) {
+    set_disp_horiz = (int)(end - start) / 10;
+    ApplyDisplayPendingChanges();
+}
+
+void Draw_DisplayVerticalRange(unsigned int start, int unsigned end) {
+    set_disp_vert = (int)(end - start);
+    ApplyDisplayPendingChanges();
+}
+
+void Draw_SetDisplayMode(DisplayMode* mode) {
+    vram_dirty = true;
+    display_rgb24 = mode->rgb24;
+    if (mode->reversed) {
+        WARNF("reverse mode not supported");
+    }
+    is_pal = mode->pal;
+    if (mode->horizontal_resolution_368) {
+        display_size.x = 368;
+    } else {
+        static const int widths[4] = {256, 320, 512, 640};
+        display_size.x = widths[mode->horizontal_resolution & 3];
+    }
+    display_size.y = mode->vertical_resolution ? 480 : 240;
+    ApplyDisplayPendingChanges();
+
+    double new_target_fps = mode->pal ? VSYNC_PAL : VSYNC_NTSC;
+    if (new_target_fps != target_frame_rate) {
+        UpdateTargetFramerate(new_target_fps);
+    }
+}
+
+// ---- drawing: everything goes to the rasterizer ---------------------------
+
+void Draw_SetTexpageMode(ParamDrawTexpageMode* p) {
+    SetDither((*(u_short*)p & 0x200) ? 1 : 0);
+    raster->texpage_mode(p);
+}
+
+void Draw_SetTextureWindow(unsigned int mask_x, unsigned int mask_y,
+                           unsigned int off_x, unsigned int off_y) {
+    raster->texture_window(mask_x, mask_y, off_x, off_y);
+}
+
+void Draw_SetMask(int bit0, int bit1) { raster->mask(bit0, bit1); }
+
+int Draw_SetHorizontalGrid(unsigned int source, unsigned int target) {
+    return raster->horizontal_grid(source, target);
+}
+
+void Draw_SetAreaStart(int x, int y) {
+    draw_area_start = (SDL_Point){x, y};
+    raster->area_start(x, y);
+}
+
+void Draw_SetAreaEnd(int x, int y) {
+    draw_area_end = (SDL_Point){x, y};
+    raster->area_end(x, y);
+}
+
+void Draw_SetOffset(int x, int y) { raster->offset(x, y); }
+
+void Draw_ClearImage(PS1_RECT* rect, u_char r, u_char g, u_char b) {
+    if (!sdl3_window && !InitPlatform()) {
+        return;
+    }
+    PERF_BEGIN;
+    raster->clear_image(rect, r, g, b);
+    PERF_END(perf_raster);
+    vram_dirty = true;
+}
+
+void Draw_LoadImage(PS1_RECT* rect, u_long* p) {
+    if (!sdl3_window && !InitPlatform()) {
+        return;
+    }
+    PERF_BEGIN;
+    raster->load_image(rect, p);
+    PERF_END(perf_raster);
+    vram_dirty = true;
+}
+
+void Draw_StoreImage(PS1_RECT* rect, u_long* p) {
+    if (!sdl3_window && !InitPlatform()) {
+        return;
+    }
+    raster->store_image(rect, p);
+}
+
+void Draw_MoveImage(PS1_RECT* rect, unsigned int x, unsigned int y) {
+    if (!sdl3_window && !InitPlatform()) {
+        return;
+    }
+    PERF_BEGIN;
+    raster->move_image(rect, x, y);
+    PERF_END(perf_raster);
+    vram_dirty = true;
+}
+
+int Draw_PushPrim(u_long* packets, int max_len) {
+    if (!sdl3_window && !InitPlatform()) {
+        return max_len;
+    }
+    PERF_BEGIN;
+    int n = raster->push_prim(packets, max_len);
+    PERF_END(perf_raster);
+    vram_dirty = true;
+    return n;
+}
+
+void Draw_ResetBuffer(void) { raster->reset_buffer(); }
+
+void Draw_FlushBuffer(void) { raster->flush_buffer(); }
+
+int Draw_ExequeSync() { return raster->exeque_sync(); }
