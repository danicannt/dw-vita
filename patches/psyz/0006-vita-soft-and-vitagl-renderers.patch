+// float-only shaders (gl_float_shaders.h): always on the Vita, else with
+// PSYZ_GL_FLOAT_SHADERS=1 to check them against the integer ones
+static bool float_shaders = false;
+
+static GLuint Init_CompileShaderWith(
+    const char* prologue, const char* source, GLenum kind) {
+    const char* sources[2] = {prologue, source};
+    GLuint shader = glCreateShader(kind);
+    glShaderSource(shader, 2, sources, NULL);
+    glCompileShader(shader);
+
+    int success;
+    glGetShaderiv(shader, GL_COMPILE_STATUS, &success);
+    if (!success) {
+        char compilerLog[1024];
+        glGetShaderInfoLog(shader, sizeof(compilerLog), NULL, compilerLog);
+        ERRORF("%s shader compilation failed:\n%s",
+               kind == GL_VERTEX_SHADER ? "vertex" : "fragment", compilerLog);
+    }
+    return shader;
+}
+
