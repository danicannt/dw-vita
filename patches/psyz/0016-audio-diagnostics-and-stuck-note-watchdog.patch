+// Notes of this score held longer than its longest note (plus a margin) lost
+// their note off (how is still open: voice reuse between the score's notes);
+// they are let go here instead of looping on.
+static void release_overdue(short seq, short sep) {
+    SeqExtra* x = &extra[seq][sep];
+    short seq_sep_no = seq | (sep << 8);
+    unsigned limit = x->max_note + x->max_note / 2 + 4800; // + 480 ticks
+    if (!x->max_note) {
+        return;
+    }
+    for (int v = 0; v < _SsVmMaxVoice; v++) {
+        // by the SPU's state: the key off of these got lost on the way, the
+        // score already let them go (voice_channel -1)
+        if (voice_seq[v] == seq_sep_no && voice_pos[v] != NO_POS &&
+            (u16)_svm_voice[v].seq_sep_no != 0x21 &&
+            x->pos - voice_pos[v] > limit && Psyz_SpuVoiceSustaining(v)) {
+            WARNF("note %d (ch %d, voice %d) held past the song's longest "
+                  "note: released", voice_note[v], voice_channel[v], v);
+            force_off(v);
+            voice_pos[v] = NO_POS;
+        }
+    }
+}
