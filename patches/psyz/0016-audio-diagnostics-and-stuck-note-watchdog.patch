+// The score's longest note in delta units, from the first event (read_pos):
+// the stuck-note guard below lets no note of this song sound longer.
+static unsigned longest_note(const u8* p, const u8* end) {
+    unsigned t = 0, longest = 0;
+    static unsigned on_at[16][128]; // static: runs on the IRQ thread, under the kernel lock
+    static u8 on[16][128];
+    u8 rs = 0;
+    memset(on, 0, sizeof(on));
+    while (p < end) {
+        u8 st = *p;
+        if (st & 0x80) {
+            rs = st;
+            p++;
+        }
+        st = rs;
+        if (st == 0xFF) { // PsyQ metas carry no length byte
+            u8 type = *p++;
+            if (type == 0x51) {
+                p += 3; // tempo
+            } else {
+                break; // 2F end of track, or unknown
+            }
+        } else {
+            u8 hi = st & 0xF0, ch = st & 0x0F;
+            if (hi == 0x80 || hi == 0x90) {
+                u8 n = p[0] & 0x7F, vel = p[1] & 0x7F;
+                p += 2;
+                if (hi == 0x90 && vel) {
+                    on[ch][n] = 1;
+                    on_at[ch][n] = t;
+                } else if (on[ch][n]) {
+                    on[ch][n] = 0;
+                    if (t - on_at[ch][n] > longest) {
+                        longest = t - on_at[ch][n];
+                    }
+                }
+            } else if (hi == 0xA0 || hi == 0xB0 || hi == 0xE0) {
+                p += 2;
+            } else if (hi == 0xC0 || hi == 0xD0) {
+                p += 1;
+            } else {
+                break;
+            }
+        }
+        unsigned d = 0; // next delta
+        u8 b;
+        do {
+            if (p >= end) {
+                return longest * 10;
+            }
+            b = *p++;
+            d = (d << 7) | (b & 0x7F);
+        } while (b & 0x80);
+        t += d;
+    }
+    return longest * 10;
+}
