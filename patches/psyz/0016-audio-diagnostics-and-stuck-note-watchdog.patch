+// ---------------------------------------------------------------- watchdog
+
+void PS1_EnterCriticalSection(void);
+void PS1_ExitCriticalSection(void);
+unsigned Psyz_SpuTicks(void);
+int Psyz_SpuVoiceHeldSince(int v, unsigned since);
+
+// Cuts the voices still sounding from before `since` (an SPU tick count) that
+// no playing sequence owns: a note whose key off got lost (a looping sound kept
+// over the next map). The port calls it shortly after a map change; the
+// sequence still playing across maps of one area keeps its voices.
+int Psyz_SndCutStuckVoices(unsigned since) {
+    int cut = 0;
+    PS1_EnterCriticalSection();
+    for (int v = 0; v < NUM_VOICES; v++) {
+        if (!Psyz_SpuVoiceHeldSince(v, since)) {
+            continue;
+        }
+        short owner = _svm_voice[v].seq_sep_no;
+        int seq = owner & 0xFF, sep = (owner >> 8) & 0xFF;
+        INFOF("held over map change: voice %d owner 0x%x note %d ch %d "
+              "sample 0x%x", v, (unsigned short)owner, _svm_voice[v].note,
+              voice_channel[v], Psyz_SpuRead(offsetof(SPU_RXX, voice[v].addr)));
+        if (owner != 0x21 && seq < _snd_seq_s_max && sep < _snd_seq_t_max &&
+            (_snd_openflag & (1 << seq)) && _ss_score[seq] &&
+            _ss_score[seq][sep].play_mode == SSPLAY_PLAY) {
+            continue; // the music still playing
+        }
+        WARNF("stuck voice %d cut (owner 0x%x, sample 0x%x)", v,
+              (unsigned short)owner, Psyz_SpuRead(offsetof(SPU_RXX, voice[v].addr)));
+        _svm_cur.voice = v;
+        _SsVmKeyOffNow(0);
+        // fastest linear release, as SsUtAllKeyOff, then the key off
+        Psyz_SpuWrite(offsetof(SPU_RXX, voice[v].adsr[1]), 0x4000);
+        Psyz_SpuWrite(v < 16 ? offsetof(SPU_RXX, key_off[0])
+                             : offsetof(SPU_RXX, key_off[1]),
+                      (unsigned short)(1u << (v & 15)));
+        cut++;
+    }
+    PS1_ExitCriticalSection();
+    return cut;
+}
