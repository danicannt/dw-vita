  */
 int Psyz_VideoGetPgxp(void);
 
+/**
+ * @brief PGXP depth buffer (default: off; needs Psyz_VideoSetPgxp)
+ *
+ * Opaque polygons drawn with PGXP depth-test against each other with their
+ * GTE depth, so parts of a model that the ordering table sorted wrong no
+ * longer cut into each other. 2D primitives keep the ordering-table order.
+ * Only the sdl3_gl renderer implements it; others return -1.
+ */
+int Psyz_VideoSetPgxpDepth(int on);
+int Psyz_VideoGetPgxpDepth(void);
+
+/**
+ * @brief Marks the GTE projections that follow as a model's (default: off)
+ *
+ * Only models' polygons get the PGXP depth buffer and the texture filter.
+ * Scenery (map objects, signs, fences) keeps the ordering-table order, as
+ * on the PS1, and its pixel-art textures: its meshes can reach into the
+ * spaces characters walk through, so depth would cut them.
+ */
+void Psyz_VideoSetPgxpModel(int on);
+
+/**
+ * @brief Texture filter for PGXP models' polygons (default: 0)
+ *
+ * 0 keeps the PS1's nearest texels, 1 is a 3-point filter (as on the N64),
+ * 2 bilinear. Each polygon only filters within its own UVs and transparent
+ * texels stay sharp. HUD, text and backgrounds are never filtered.
+ * Only the sdl3_gl renderer implements it; others return -1.
+ */
+int Psyz_VideoSetModelFilter(int mode);
+int Psyz_VideoGetModelFilter(void);
+
