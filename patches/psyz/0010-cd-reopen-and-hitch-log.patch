+static void PerfHitch(double ms, double freq) {
+    char line[640];
+    double known = psyz_perf_cd_us / 1000.0;
+    int n = SDL_snprintf(line, sizeof(line),
+                         "hitch: %.0f ms | cd %u reads %u sectors %.1f ms", ms,
+                         psyz_perf_cd_reads, psyz_perf_cd_sectors,
+                         psyz_perf_cd_us / 1000.0);
+    for (int i = 0; i < PERF_COUNT && n < (int)sizeof(line); i++) {
+        if (perf_frame_calls[i] == 0) {
+            continue;
+        }
+        double op = perf_frame_ticks[i] * 1000.0 / freq;
+        if (i != PERF_SWAP) { // already in present
+            known += op;
+        }
+        n += SDL_snprintf(line + n, sizeof(line) - n, " | %s %u %.1f ms",
+                          perf_names[i], perf_frame_calls[i], op);
+    }
+    if (n < (int)sizeof(line)) {
+        SDL_snprintf(line + n, sizeof(line) - n, " | other %.1f ms",
+                     ms > known ? ms - known : 0.0);
+    }
+    INFOF("%s", line);
+}
+
+// "hitch:" for a frame of HITCH_MS or more, "slow:" for a run of frames over
+// SLOW_MS once 30 frames in a row are back under it (or after 2 s of it)
+static void PerfFrame(void) {
+    static Uint64 prev, slow_start;
+    static unsigned slow_n, fast_n;
+    static double slow_ms, slow_worst, slow_swap, slow_draw;
+    Uint64 now = SDL_GetPerformanceCounter();
+    double freq = (double)SDL_GetPerformanceFrequency();
+    double ms = prev ? (double)(now - prev) * 1000.0 / freq : 0.0;
+    double swap = perf_frame_ticks[PERF_SWAP] * 1000.0 / freq;
+    prev = now;
+    if (ms >= HITCH_MS) {
+        PerfHitch(ms, freq);
+    } else if (ms > SLOW_MS) {
+        if (slow_n == 0) {
+            slow_start = now;
+            slow_worst = 0.0;
+            slow_ms = slow_swap = slow_draw = 0.0;
+        }
+        slow_n++;
+        slow_ms += ms;
+        slow_swap += swap;
+        slow_draw += perf_frame_ticks[PERF_FLUSH] * 1000.0 / freq;
+        if (ms > slow_worst) {
+            slow_worst = ms;
+        }
+        fast_n = 0;
+    } else if (slow_n) {
+        fast_n++;
+    }
+    if (slow_n && (fast_n >= 30 || (double)(now - slow_start) > 2.0 * freq)) {
+        INFOF("slow: %u frames over %d ms in %.1f s, %.1f ms on average "
+              "(worst %.0f) | swap %.1f ms | draw %.1f ms | other %.1f ms",
+              slow_n, SLOW_MS, (double)(now - slow_start) / freq,
+              slow_ms / slow_n, slow_worst, slow_swap / slow_n,
+              slow_draw / slow_n, (slow_ms - slow_swap - slow_draw) / slow_n);
+        slow_n = fast_n = 0;
+    }
+    SDL_memset(perf_frame_ticks, 0, sizeof(perf_frame_ticks));
+    SDL_memset(perf_frame_calls, 0, sizeof(perf_frame_calls));
+    psyz_perf_cd_reads = psyz_perf_cd_sectors = psyz_perf_cd_us = 0;
+}
 
