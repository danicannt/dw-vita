+// SEQ ("pQES") interpreter for libsnd: the parts of midiread.c, midinote.c,
+// midicc.c, midiprog.c, midibend.c, midimeta.c and vm_key.c that are still
+// assembly in the decomp, written from the PsyQ behaviour.
+//
+// _SsSeqPlay runs once per sound tick (SsSeqCalledTbyT). delta_value holds
+// the time left to the event at seq_ptr in 1/10 sequence ticks (that is what
+// _SsReadDeltaValue returns) and each sound tick consumes
+// resolution * tempo(BPM) * 10 / (VBLANK_MINUS * 60) of it.
+//
+// SEQ events are MIDI with running status. Meta events carry no length byte:
+// FF 51 tt tt tt (tempo, us per quarter) and FF 2F (end of track). Loops are
+// NRPN through data entry: CC99=20 marks the loop start and the CC6 that
+// follows gives the count (127 = forever), CC99=30 jumps back to the start.
+#include <psyz.h>
+#include <libsnd.h>
+#include <libspu.h>
+#include <psyz/log.h>
+#include <string.h>
+#include "../../decomp/src/libspu/libspu_private.h"
+#include "../../decomp/src/libsnd/libsnd_private.h"
+
+#define N_SEQ 32
+#define N_SEP 16
+
+void _SsVmKeyOffNow(int mode);
+
+// state the PsyQ score keeps in fields the decomp has not named yet
+typedef struct {
+    unsigned tick_frac;  // remainder of the per-tick delta consumption
+    u8* loop_ptr;        // first delta after the loop start event
+    u8 loop_status;      // running status at the loop start
+    u8 loop_count;       // 127 = forever
+    u8 loop_done;        // laps already played
+    u8 nrpn[16];         // last CC99 value per channel
+    u8 expr[16];         // CC11
+    u8 bend[16];         // pitch bend MSB, 64 = centre
+} SeqExtra;
+
+static SeqExtra extra[N_SEQ][N_SEP];
+
+static struct SeqStruct* score_of(short seq, short sep) {
+    return &_ss_score[seq][sep];
+}
+
+static void reset_extra(SeqExtra* x) {
+    memset(x, 0, sizeof(*x));
+    x->loop_count = 127;
+    for (int i = 0; i < 16; i++) {
+        x->expr[i] = 127;
+        x->bend[i] = 64;
+        x->nrpn[i] = 0xFF;
+    }
+}
+
+// Pitch of voice v for its note plus the channel bend (tone range pbmin/pbmax
+// semitones, in 1/128 semitone steps like VagAtr.shift).
+static unsigned short voice_pitch(int note, int bend, const VagAtr* tn) {
+    int fine = 0;
+    if (bend > 64) {
+        fine = (bend - 64) * tn->pbmax * 128 / 63;
+    } else if (bend < 64) {
+        fine = (bend - 64) * tn->pbmin * 128 / 64;
+    }
+    int total = note * 128 + fine;
+    if (total < 0) {
+        total = 0;
+    }
+    return note2pitch2((unsigned short)(total >> 7), (unsigned short)(total & 127));
+}
+
+// Same volume/pan maths as _SsVmKeyOnNow, for a voice already playing.
+static void voice_volume(int i, struct SeqStruct* ss, int volume, int pan) {
+    const VagAtr* tn = &_svm_tn[_svm_voice[i].fake_program * 16 + _svm_voice[i].tone];
+    unsigned vol = (volume * (_svm_vh->mvol * 16383)) / 16129;
+    unsigned chR = ((vol * _svm_pg[_svm_voice[i].prog].mvol) * tn->vol) / 16129;
+    unsigned chL;
+    vol = (chR * ss->voll) / 127;
+    chR = (chR * ss->volr) / 127;
+    if (tn->pan < 64) {
+        chR = (chR * tn->pan) / 63;
+        chL = vol;
+    } else {
+        chL = (vol * (127 - tn->pan)) / 63;
+    }
+    int mpan = _svm_pg[_svm_voice[i].prog].mpan;
+    if (mpan < 64) {
+        chR = (chR * mpan) / 63;
+    } else {
+        chL = (chL * (127 - mpan)) / 63;
+    }
+    if (pan < 64) {
+        chR = (chR * pan) / 63;
+    } else {
+        chL = (chL * (127 - pan)) / 63;
+    }
+    if (_svm_stereo_mono == 1) {
+        if (chL < chR) {
+            chL = chR;
+        } else {
+            chR = chL;
+        }
+    }
+    ((short*)_svm_sreg_buf)[i * 8 + 0] = (chL * chL) / 16383;
+    ((short*)_svm_sreg_buf)[i * 8 + 1] = (chR * chR) / 16383;
+    _svm_sreg_dirty[i] |= 3;
+}
+
+static int chan_volume(struct SeqStruct* ss, SeqExtra* x, int ch, int vel) {
+    return vel * ss->vol[ch] / 127 * x->expr[ch] / 127;
+}
+
+// Applies f to every voice this sequence channel is sounding.
+#define FOR_CHANNEL_VOICES(seq, sep, ch, i)                                     \
+    for (int i = 0; i < _SsVmMaxVoice; i++)                                    \
+        if ((u16)_svm_voice[i].seq_sep_no == (u16)((seq) | ((sep) << 8)) &&     \
+            _svm_voice[i].unk1b &&                                             \
+            _svm_voice[i].prog == score_of(seq, sep)->programs[ch])
+
+static void refresh_channel(short seq, short sep, int ch, int pitch_too) {
+    struct SeqStruct* ss = score_of(seq, sep);
+    SeqExtra* x = &extra[seq][sep];
+    FOR_CHANNEL_VOICES(seq, sep, ch, i) {
+        if (_SsVmVSetUp(_svm_voice[i].vabId, _svm_voice[i].prog)) {
+            continue;
+        }
+        voice_volume(i, ss, chan_volume(ss, x, ch, _svm_voice[i].voll1), ss->panpot[ch]);
+        if (pitch_too) {
+            const VagAtr* tn = &_svm_tn[_svm_voice[i].fake_program * 16 + _svm_voice[i].tone];
+            _svm_cur.tone = _svm_voice[i].tone;
+            _svm_cur.fake_program = _svm_voice[i].fake_program;
+            unsigned short p = voice_pitch(_svm_voice[i].note, x->bend[ch], tn);
+            ((short*)_svm_sreg_buf)[i * 8 + 2] = p;
+            _svm_voice[i].unk04 = p;
+            _svm_sreg_dirty[i] |= 4;
+        }
+    }
+}
+
+static void key_off(short seq, short sep, int ch, int note) {
+    FOR_CHANNEL_VOICES(seq, sep, ch, i) {
+        if (_svm_voice[i].note == note) {
+            _svm_cur.voice = i;
+            _SsVmKeyOffNow(0);
+        }
+    }
+}
+
+// _SsVmKeyOn: every tone of the channel's program whose key range holds the
+// note gets a voice (VAB programs layer several tones).
+static void key_on(short seq, short sep, int ch, int note, int vel) {
+    struct SeqStruct* ss = score_of(seq, sep);
+    SeqExtra* x = &extra[seq][sep];
+    int prog = ss->programs[ch];
+    short seq_sep_no = seq | (sep << 8);
+
+    if (_SsVmVSetUp(ss->vab_id, prog)) {
+        return;
+    }
+    int ntones = _svm_pg[prog].tones;
+    for (int t = 0; t < ntones && t < 16; t++) {
+        const VagAtr* tn = &_svm_tn[_svm_cur.fake_program * 16 + t];
+        if (note < tn->min || note > tn->max || tn->vag == 0) {
+            continue;
+        }
+        _svm_cur.seq_sep_no = seq_sep_no;
+        _svm_cur.note = note;
+        _svm_cur.fine = 0;
+        _svm_cur.tone = t;
+        _svm_cur.volume = chan_volume(ss, x, ch, vel);
+        _svm_cur.pan = ss->panpot[ch];
+        _svm_cur.mvol = _svm_pg[prog].mvol;
+        _svm_cur.mpan = _svm_pg[prog].mpan;
+        _svm_cur.prog_tones = ntones;
+        _svm_cur.tone_prior = tn->prior;
+        _svm_cur.tone_vag_idx = tn->vag;
+        _svm_cur.tone_vol = tn->vol;
+        _svm_cur.tone_pan = tn->pan;
+        _svm_cur.tone_center = tn->center;
+        _svm_cur.tone_shift = tn->shift;
+        _svm_cur.tone_mode = tn->mode;
+        _svm_cur.tone_min = tn->min;
+        _svm_cur.tone_max = tn->max;
+
+        int voice = _SsVmAlloc(tn->vag);
+        if (voice >= _SsVmMaxVoice) {
+            return;
+        }
+        // a stolen voice still sounding for someone else is cut first
+        _svm_cur.voice = voice;
+        _svm_voice[voice].seq_sep_no = seq_sep_no;
+        _svm_voice[voice].vabId = ss->vab_id;
+        _svm_voice[voice].fake_program = _svm_cur.fake_program;
+        _svm_voice[voice].prog = prog;
+        _svm_voice[voice].vag_idx = tn->vag;
+        _svm_voice[voice].tone = t;
+        _svm_voice[voice].note = note;
+        _svm_voice[voice].voll1 = vel;
+        _svm_voice[voice].pan = ss->panpot[ch];
+        _svm_voice[voice].unk1b = 1;
+        _svm_voice[voice].unk2 = 0;
+        _SsVmDoAllocate();
+        _SsVmKeyOnNow(1, voice_pitch(note, x->bend[ch], tn));
+    }
+}
+
+// ---------------------------------------------------------------- SsFCALL
+
+void _SsNoteOn(short seq, short sep, unsigned char note, unsigned char vel) {
+    struct SeqStruct* ss = score_of(seq, sep);
+    int ch = ss->channel_idx;
+    if (ss->channel_mute & (1 << ch)) {
+        return;
+    }
+    if (vel) {
+        key_on(seq, sep, ch, note, vel);
+    } else {
+        key_off(seq, sep, ch, note);
+    }
+}
+
+void _SsSetProgramChange(short seq, short sep, unsigned char prog) {
+    struct SeqStruct* ss = score_of(seq, sep);
+    ss->programs[ss->channel_idx] = prog;
+}
+
+void _SsSetPitchBend(short seq, short sep) {
+    struct SeqStruct* ss = score_of(seq, sep);
+    int ch = ss->channel_idx;
+    ss->seq_ptr++; // LSB, libsnd only uses the MSB
+    extra[seq][sep].bend[ch] = *ss->seq_ptr++ & 0x7F;
+    refresh_channel(seq, sep, ch, 1);
+}
+
+void _SsContBankChange(short seq, short sep) { (void)seq, (void)sep; }
+
+void _SsContMainVol(short seq, short sep, unsigned char vol) {
+    struct SeqStruct* ss = score_of(seq, sep);
+    ss->vol[ss->channel_idx] = vol;
+    refresh_channel(seq, sep, ss->channel_idx, 0);
+}
+
+void _SsContPanpot(short seq, short sep, unsigned char pan) {
+    struct SeqStruct* ss = score_of(seq, sep);
+    ss->panpot[ss->channel_idx] = pan;
+    refresh_channel(seq, sep, ss->channel_idx, 0);
+}
+
+void _SsContExpression(short seq, short sep, unsigned char expr) {
+    struct SeqStruct* ss = score_of(seq, sep);
+    extra[seq][sep].expr[ss->channel_idx] = expr;
+    refresh_channel(seq, sep, ss->channel_idx, 0);
+}
+
+void _SsContDamper(short seq, short sep, unsigned char v) {
+    (void)seq, (void)sep, (void)v;
+}
+
+void _SsContExternal(short seq, short sep, unsigned char v) {
+    (void)seq, (void)sep, (void)v;
+}
+
+void _SsContNrpn1(short seq, short sep, unsigned char v) { // CC99
+    struct SeqStruct* ss = score_of(seq, sep);
+    SeqExtra* x = &extra[seq][sep];
+    x->nrpn[ss->channel_idx] = v;
+    if (v == 20) {
+        x->loop_ptr = ss->seq_ptr;
+        x->loop_status = ss->running_status;
+        x->loop_count = 127;
+        x->loop_done = 0;
+    } else if (v == 30 && x->loop_ptr) {
+        if (x->loop_count == 127 || ++x->loop_done < x->loop_count) {
+            ss->seq_ptr = x->loop_ptr;
+            ss->running_status = x->loop_status;
+        }
+    }
+}
+
+void _SsContNrpn2(short seq, short sep, unsigned char v) { // CC98
+    (void)seq, (void)sep, (void)v;
+}
+
+void _SsContRpn1(short seq, short sep, unsigned char v) {
+    (void)seq, (void)sep, (void)v;
+}
+
+void _SsContRpn2(short seq, short sep, unsigned char v) {
+    (void)seq, (void)sep, (void)v;
+}
+
+void _SsContDataEntry(short seq, short sep, unsigned char v) { // CC6
+    struct SeqStruct* ss = score_of(seq, sep);
+    SeqExtra* x = &extra[seq][sep];
+    if (x->nrpn[ss->channel_idx] == 20) {
+        x->loop_count = v;
+    }
+}
+
+void _SsContResetAll(short seq, short sep) {
+    struct SeqStruct* ss = score_of(seq, sep);
+    int ch = ss->channel_idx;
+    extra[seq][sep].expr[ch] = 127;
+    extra[seq][sep].bend[ch] = 64;
+    refresh_channel(seq, sep, ch, 1);
+}
+
+void _SsSetControlChange(short seq, short sep, unsigned char cc) {
+    struct SeqStruct* ss = score_of(seq, sep);
+    unsigned char v = *ss->seq_ptr++ & 0x7F;
+    switch (cc) {
+    case 0:
+        _SsContBankChange(seq, sep);
+        break;
+    case 6:
+        _SsContDataEntry(seq, sep, v);
+        break;
+    case 7:
+        _SsContMainVol(seq, sep, v);
+        break;
+    case 10:
+        _SsContPanpot(seq, sep, v);
+        break;
+    case 11:
+        _SsContExpression(seq, sep, v);
+        break;
+    case 64:
+        _SsContDamper(seq, sep, v);
+        break;
+    case 91:
+        _SsContExternal(seq, sep, v);
+        break;
+    case 98:
+        _SsContNrpn2(seq, sep, v);
+        break;
+    case 99:
+        _SsContNrpn1(seq, sep, v);
+        break;
+    case 100:
+        _SsContRpn2(seq, sep, v);
+        break;
+    case 101:
+        _SsContRpn1(seq, sep, v);
+        break;
+    case 121:
+        _SsContResetAll(seq, sep);
+        break;
+    default:
+        break;
+    }
+}
+
+static void seq_end(short seq, short sep);
+
+void _SsGetMetaEvent(short seq, short sep, unsigned char type) {
+    struct SeqStruct* ss = score_of(seq, sep);
+    if (type == 0x51) {
+        u8* p = ss->seq_ptr;
+        int us = (p[0] << 16) | (p[1] << 8) | p[2];
+        ss->seq_ptr += 3;
+        if (us > 0) { // same rounding as _SsInitSoundSeq
+            ss->unk94 = us / 2 < 60000000 % us ? 60000000 / us + 1 : 60000000 / us;
+        }
+    } else if (type == 0x2F) {
+        seq_end(seq, sep);
+    }
+}
+
+// ---------------------------------------------------------------- reader
+
+int _SsSeqGetEof(short seq, short sep) {
+    return !(score_of(seq, sep)->flags & SEQ_FLAG_1);
+}
+
+// End of track: replay from the top while l_count allows it
+// (SSPLAY_INFINITY = 0 repeats forever), otherwise stop.
+static void seq_end(short seq, short sep) {
+    struct SeqStruct* ss = score_of(seq, sep);
+    if (ss->l_count == SSPLAY_INFINITY || --ss->l_count > 0) {
+        ss->seq_ptr = ss->read_pos;
+        ss->running_status = 0;
+        ss->unk94 = ss->tempo;
+        reset_extra(&extra[seq][sep]);
+        ss->delta_value += ss->unk84;
+        ss->unk15 = 1; // delta already loaded
+        return;
+    }
+    _SsVmSeqKeyOff(seq | (sep << 8));
+    ss->flags &= ~SEQ_FLAG_1;
+    ss->flags |= SEQ_FLAG_200;
+    ss->play_mode = SSPLAY_PAUSE;
+    ss->unk15 = 1;
+}
+
+// One event at seq_ptr; then reads the delta to the next one.
+void _SsGetSeqData(short seq, short sep) {
+    struct SeqStruct* ss = score_of(seq, sep);
+    u8 c = *ss->seq_ptr;
+    if (c & 0x80) {
+        ss->running_status = c;
+        ss->seq_ptr++;
+    }
+    u8 st = ss->running_status;
+    ss->unk15 = 0;
+    if (st == 0xFF) {
+        _SsGetMetaEvent(seq, sep, *ss->seq_ptr++);
+    } else {
+        ss->channel_idx = st & 0x0F;
+        u8* p = ss->seq_ptr;
+        switch (st & 0xF0) {
+        case 0x90:
+            ss->seq_ptr += 2;
+            _SsNoteOn(seq, sep, p[0] & 0x7F, p[1] & 0x7F);
+            break;
+        case 0x80:
+            ss->seq_ptr += 2;
+            _SsNoteOn(seq, sep, p[0] & 0x7F, 0);
+            break;
+        case 0xB0:
+            ss->seq_ptr++;
+            _SsSetControlChange(seq, sep, p[0] & 0x7F);
+            break;
+        case 0xC0:
+            ss->seq_ptr++;
+            _SsSetProgramChange(seq, sep, p[0] & 0x7F);
+            break;
+        case 0xE0:
+            _SsSetPitchBend(seq, sep);
+            break;
+        case 0xA0:
+            ss->seq_ptr += 2;
+            break;
+        case 0xD0:
+            ss->seq_ptr += 1;
+            break;
+        default: // sysex or garbage: nothing sane to do but stop
+            WARNF("SEQ %d/%d: status %02X", seq, sep, st);
+            ss->unk15 = 0;
+            seq_end(seq, sep);
+            ss->flags &= ~SEQ_FLAG_1;
+            return;
+        }
+    }
+    if (!ss->unk15 && (ss->flags & SEQ_FLAG_1)) {
+        ss->delta_value += _SsReadDeltaValue(seq, sep);
+    }
+}
+
+void _SsSeqPlay(short seq, short sep) {
+    struct SeqStruct* ss = score_of(seq, sep);
+    SeqExtra* x = &extra[seq][sep];
+    if (seq < 0 || seq >= N_SEQ || sep < 0 || sep >= N_SEP) {
+        return;
+    }
+    if (ss->play_mode != SSPLAY_PLAY) {
+        return;
+    }
+    if (ss->seq_ptr == ss->read_pos && ss->delta_value == ss->unk84) {
+        // fresh start (open, stop or replay): channel state back to defaults
+        reset_extra(x);
+        ss->unk94 = ss->tempo;
+    }
+    unsigned den = VBLANK_MINUS * 60;
+    x->tick_frac += (unsigned)ss->resolution * ss->unk94 * 10;
+    ss->delta_value -= x->tick_frac / den;
+    x->tick_frac %= den;
+    // guard against corrupt data looping forever inside one tick
+    for (int n = 0; n < 1024 && ss->delta_value <= 0 && (ss->flags & SEQ_FLAG_1); n++) {
+        _SsGetSeqData(seq, sep);
+    }
+}
