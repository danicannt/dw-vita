+
+// ---- widescreen canvases --------------------------------------------------
+// With Psyz_VideoSetWidescreen(extra, scale), drawing into a display buffer
+// (a drawing area the size of the display, at an origin the display has
+// shown) goes to a canvas of its own: `extra` game pixels wider on each side,
+// at `scale` canvas pixels per game pixel. Only the viewport moves, the
+// shaders keep their VRAM coordinates, so what lands past the 4:3 edges no
+// longer overdraws the VRAM next to the buffer (texture pages), and the
+// present shows the whole canvas. VRAM reads of a display buffer
+// (StoreImage, MoveImage, textures sampled from it) copy the canvas centre
+// back first; VRAM writes into it (LoadImage, MoveImage, ClearImage) are
+// mirrored into the canvas.
+static unsigned char* AllocRgb888FromFbo(GLuint fbo, int x, int y, int w,
+                                         int h);
+#define MAX_CANVAS 2
+typedef struct {
+    GLuint tex, fbo;
+    int x, y;   // display buffer origin in VRAM
+    int gw, gh; // display buffer size in game pixels
+    int pw, ph; // canvas size in pixels
+    bool dirty; // drawn since its centre was last copied back to VRAM
+} Canvas;
+static Canvas canvas[MAX_CANVAS];
+static int n_canvas = 0;
+static int active_canvas = -1;
+static unsigned wide_extra = 0, wide_scale = 1;
+static GLposi shown_origin[MAX_CANVAS];
+static int n_shown = 0;
+static GLuint canvas_upload_tex = 0;
+
+static GLuint quad_program = 0, quad_vao = 0, quad_vbo = 0;
+static const char quad_vertex_body[] = {"ATTR vec2 pos;\n"
+                                        "ATTR vec2 uv;\n"
+                                        "VARY vec2 vUV;\n"
+                                        "void main() {\n"
+                                        "    vUV = uv;\n"
+                                        "    gl_Position = vec4(pos, 0.0, 1.0);\n"
+                                        "}\n"};
+static const char quad_fragment_body[] = {"VARY vec2 vUV;\n"
+                                          "uniform sampler2D tex;\n"
+                                          "void main() {\n"
+                                          "    FragColor = TEX2D(tex, vUV);\n"
+                                          "}\n"};
+
+static bool InitQuad(void) {
+    if (quad_program) {
+        return true;
+    }
+#if defined(__vita__)
+    GLuint vs = Init_CompileShaderWith(
+        float_prologue_vs_vita, quad_vertex_body, GL_VERTEX_SHADER);
+    GLuint fs = Init_CompileShaderWith(
+        float_prologue_fs_vita, quad_fragment_body, GL_FRAGMENT_SHADER);
+#else
+    GLuint vs = Init_CompileShaderWith(
+        float_prologue_vs_core, quad_vertex_body, GL_VERTEX_SHADER);
+    GLuint fs = Init_CompileShaderWith(
+        float_prologue_fs_core, quad_fragment_body, GL_FRAGMENT_SHADER);
+#endif
+    GLuint program = glCreateProgram();
+    glAttachShader(program, vs);
+    glAttachShader(program, fs);
+    glBindAttribLocation(program, 0, "pos");
+    glBindAttribLocation(program, 1, "uv");
+    glLinkProgram(program);
+    glDeleteShader(vs);
+    glDeleteShader(fs);
+    int success = 0;
+    glGetProgramiv(program, GL_LINK_STATUS, &success);
+    if (!success) {
+        ERRORF("quad shader failed to link");
+        glDeleteProgram(program);
+        return false;
+    }
+    glUseProgram(program);
+    glUniform1i(glGetUniformLocation(program, "tex"), 0);
+    glUseProgram(shader_program);
+#if !defined(__vita__)
+    // core profiles need a buffer: no client-side vertex arrays
+    glGenVertexArrays(1, &quad_vao);
+    glGenBuffers(1, &quad_vbo);
+    glBindVertexArray(quad_vao);
+    glBindBuffer(GL_ARRAY_BUFFER, quad_vbo);
+    glBufferData(GL_ARRAY_BUFFER, 16 * sizeof(float), NULL, GL_STREAM_DRAW);
+    glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 4 * sizeof(float), 0);
+    glVertexAttribPointer(
+        1, 2, GL_FLOAT, GL_FALSE, 4 * sizeof(float), (void*)(2 * sizeof(float)));
+    glEnableVertexAttribArray(0);
+    glEnableVertexAttribArray(1);
+    glBindVertexArray(0);
+#endif
+    quad_program = program;
+    return true;
+}
+
+// textured quad over the current viewport: (x0,y0)-(x1,y1) in clip space,
+// (u0,v0) at (x0,y0) and (u1,v1) at (x1,y1); no blending, scissor untouched
+static void DrawTexQuad(GLuint tex, float x0, float y0, float x1, float y1,
+                        float u0, float v0, float u1, float v1) {
+    if (!InitQuad()) {
+        return;
+    }
+    const float q[16] = {x0, y0, u0, v0, x1, y0, u1, v0,
+                         x0, y1, u0, v1, x1, y1, u1, v1};
+    glDisable(GL_BLEND);
+    glUseProgram(quad_program);
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, tex);
+#if defined(__vita__)
+    glBindVertexArray(0);
+    glBindBuffer(GL_ARRAY_BUFFER, 0);
+    glEnableVertexAttribArray(0);
+    glEnableVertexAttribArray(1);
+    glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 4 * sizeof(float), q);
+    glVertexAttribPointer(1, 2, GL_FLOAT, GL_FALSE, 4 * sizeof(float), q + 2);
+    glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+    glDisableVertexAttribArray(0);
+    glDisableVertexAttribArray(1);
+#else
+    glBindVertexArray(quad_vao);
+    glBindBuffer(GL_ARRAY_BUFFER, quad_vbo);
+    glBufferData(GL_ARRAY_BUFFER, sizeof(q), q, GL_STREAM_DRAW);
+    glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+    glBindVertexArray(0);
+#endif
+    glEnable(GL_BLEND);
+    glUseProgram(shader_program);
+    glBindTexture(GL_TEXTURE_2D, vram_texture);
+}
+
+static void DeleteCanvas(Canvas* c) {
+    glDeleteFramebuffers(1, &c->fbo);
+    glDeleteTextures(1, &c->tex);
+    c->fbo = c->tex = 0;
+}
+
+static bool CreateCanvas(Canvas* c, int x, int y, int gw, int gh) {
+    c->x = x;
+    c->y = y;
+    c->gw = gw;
+    c->gh = gh;
+    c->pw = (gw + 2 * (int)wide_extra) * (int)wide_scale;
+    c->ph = gh * (int)wide_scale;
+    c->dirty = false;
+    glGenTextures(1, &c->tex);
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, c->tex);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, c->pw, c->ph, 0, GL_RGBA,
+                 GL_UNSIGNED_BYTE, NULL);
+    glGenFramebuffers(1, &c->fbo);
+    glBindFramebuffer(GL_FRAMEBUFFER, c->fbo);
+    glFramebufferTexture2D(
+        GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, c->tex, 0);
+    bool ok =
+        glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+    if (ok) {
+        glDisable(GL_SCISSOR_TEST);
+        glClearColor(0, 0, 0, 0);
+        glClear(GL_COLOR_BUFFER_BIT);
+        glEnable(GL_SCISSOR_TEST);
+    }
+    glBindTexture(GL_TEXTURE_2D, vram_texture);
+    if (!ok) {
+        ERRORF("widescreen canvas creation failed (%dx%d)", c->pw, c->ph);
+        DeleteCanvas(c);
+    }
+    return ok;
+}
+
+static void DeleteAllCanvases(void) {
+    for (int i = 0; i < n_canvas; i++) {
+        DeleteCanvas(&canvas[i]);
+    }
+    n_canvas = 0;
+    active_canvas = -1;
+}
+
+static bool CanvasOverlaps(const Canvas* c, int x, int y, int w, int h) {
+    return x < c->x + c->gw && x + w > c->x && y < c->y + c->gh &&
+           y + h > c->y;
+}
+
+// the canvas for the current drawing area, or -1 to draw into VRAM
+static int FindCanvas(int x, int y, int w, int h) {
+    if (!wide_extra || internal_res != 1 || w != display_size.x ||
+        h != display_size.y) {
+        return -1;
+    }
+    bool shown = false;
+    for (int i = 0; i < n_shown; i++) {
+        if (shown_origin[i].x == x && shown_origin[i].y == y) {
+            shown = true;
+        }
+    }
+    if (!shown) {
+        return -1;
+    }
+    for (int i = 0; i < n_canvas; i++) {
+        if (canvas[i].x == x && canvas[i].y == y) {
+            if (canvas[i].gw == w && canvas[i].gh == h) {
+                return i;
+            }
+            // the display mode changed size: start over
+            DeleteCanvas(&canvas[i]);
+            return CreateCanvas(&canvas[i], x, y, w, h) ? i : -1;
+        }
+    }
+    if (n_canvas == MAX_CANVAS ||
+        !CreateCanvas(&canvas[n_canvas], x, y, w, h)) {
+        return -1;
+    }
+    return n_canvas++;
+}
+
+// the canvas's VRAM origin: its pixel 0 shows VRAM x = buffer x - extra
+// (left of VRAM x 0 for a buffer at the left edge, which the clip volume
+// would cut if the viewport moved instead), its row 0 the buffer's top row
+static void CanvasOrigin(const Canvas* c, float* x, float* y) {
+    *x = (float)(c->x - (int)wide_extra);
+    *y = (float)c->y;
+}
+
+// viewport for the main shader with vramOrigin = CanvasOrigin
+static void SetCanvasViewport(const Canvas* c) {
+    (void)c;
+    const int s = (int)wide_scale;
+    glViewport(0, 0, VRAM_W * s, VRAM_H * s);
+}
+
+// the canvas pixels a VRAM rectangle covers; one spanning the whole buffer
+// width takes the margins too
+static SDL_Rect CanvasRect(const Canvas* c, int x, int y, int w, int h) {
+    const int s = (int)wide_scale;
+    SDL_Rect r;
+    if (x <= c->x && x + w >= c->x + c->gw) {
+        r.x = 0;
+        r.w = c->pw;
+    } else {
+        r.x = (x - c->x + (int)wide_extra) * s;
+        r.w = w * s;
+    }
+    int y0 = CLAMP(y, c->y, c->y + c->gh);
+    int y1 = CLAMP(y + h, c->y, c->y + c->gh);
+    r.y = (y0 - c->y) * s;
+    r.h = (y1 - y0) * s;
+    return r;
+}
+
+static void ApplyScissor(void);
+
+// copy the canvas centre (the 4:3 part) back into its VRAM display buffer
+static void SyncCanvasToVram(Canvas* c) {
+    glDisable(GL_SCISSOR_TEST);
+    glBindFramebuffer(GL_FRAMEBUFFER, vram_fbo);
+    glViewport(c->x, c->y, c->gw, c->gh);
+    const float tw = (float)(c->gw + 2 * (int)wide_extra);
+    DrawTexQuad(c->tex, -1.0f, -1.0f, 1.0f, 1.0f, (float)wide_extra / tw, 0.0f,
+                (float)(wide_extra + c->gw) / tw, 1.0f);
+    c->dirty = false;
+    BindDrawFbo();
+    ApplyScissor();
+}
+
+static void SyncCanvasesOverlapping(int x, int y, int w, int h) {
+    for (int i = 0; i < n_canvas; i++) {
+        if (canvas[i].dirty && CanvasOverlaps(&canvas[i], x, y, w, h)) {
+            SyncCanvasToVram(&canvas[i]);
+        }
+    }
+}
+
+// before a flush: textures or palettes read from a display buffer that only
+// the canvas has up to date
+static void SyncCanvasesSampled(void) {
+    bool any = false;
+    for (int i = 0; i < n_canvas; i++) {
+        any |= canvas[i].dirty;
+    }
+    if (!any) {
+        return;
+    }
+    for (int v = 0; v < n_vertices; v++) {
+        const Vertex* vx = &vertex_buf[v];
+        if (vx->t & TPAGE_NOTEXTURE) {
+            continue;
+        }
+        int depth = (vx->t >> 7) & 3;
+        int px = (vx->t & 15) * 64, py = ((vx->t >> 4) & 1) * 256;
+        int pw = depth == 0 ? 64 : depth == 1 ? 128 : 256;
+        int cx = (vx->c & 63) * 16, cy = vx->c >> 6;
+        for (int i = 0; i < n_canvas; i++) {
+            Canvas* c = &canvas[i];
+            if (c->dirty && (CanvasOverlaps(c, px, py, pw, 256) ||
+                             (depth < 2 && CanvasOverlaps(c, cx, cy, 256, 1)))) {
+                SyncCanvasToVram(c);
+            }
+        }
+    }
+}
+
+// a VRAM rectangle that was just written (texture `tex`, the region's pixels
+// at uv0-uv1) mirrored into the canvases it touches
+static void CopyIntoCanvases(int x, int y, int w, int h, GLuint tex, float u0,
+                             float v0, float u1, float v1, bool clear_sides) {
+    bool done = false;
+    for (int i = 0; i < n_canvas; i++) {
+        Canvas* c = &canvas[i];
+        if (!CanvasOverlaps(c, x, y, w, h)) {
+            continue;
+        }
+        SDL_Rect full = CanvasRect(c, x, y, w, h);
+        glBindFramebuffer(GL_FRAMEBUFFER, c->fbo);
+        glEnable(GL_SCISSOR_TEST);
+        if (clear_sides && full.w == c->pw) {
+            glScissor(full.x, full.y, full.w, full.h);
+            glClearColor(0, 0, 0, 0);
+            glClear(GL_COLOR_BUFFER_BIT);
+        }
+        glScissor(0, 0, c->pw, c->ph);
+        const int s = (int)wide_scale;
+        glViewport((x - c->x + (int)wide_extra) * s, (y - c->y) * s, w * s,
+                   h * s);
+        DrawTexQuad(tex, -1.0f, -1.0f, 1.0f, 1.0f, u0, v0, u1, v1);
+        done = true;
+    }
+    if (done) {
+        BindDrawFbo();
+        ApplyScissor();
+    }
+}
+
+static void UploadIntoCanvases(PS1_RECT* rect, const u8* rgba) {
+    if (!n_canvas || display_rgb24) {
+        return;
+    }
+    bool any = false;
+    for (int i = 0; i < n_canvas; i++) {
+        any |= CanvasOverlaps(&canvas[i], rect->x, rect->y, rect->w, rect->h);
+    }
+    if (!any) {
+        return;
+    }
+    if (!canvas_upload_tex) {
+        glGenTextures(1, &canvas_upload_tex);
+    }
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, canvas_upload_tex);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, rect->w, rect->h, 0, GL_RGBA,
+                 GL_UNSIGNED_BYTE, rgba);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glBindTexture(GL_TEXTURE_2D, vram_texture);
+    CopyIntoCanvases(rect->x, rect->y, rect->w, rect->h, canvas_upload_tex,
+                     0.0f, 0.0f, 1.0f, 1.0f, true);
+}
+
+static Canvas* ShownCanvas(void) {
+    for (int i = 0; i < n_canvas; i++) {
+        if (canvas[i].x == display_area.x && canvas[i].y == display_area.y &&
+            canvas[i].gw == display_size.x && canvas[i].gh == display_size.y) {
+            return &canvas[i];
+        }
+    }
+    return NULL;
+}
+
+int Psyz_VideoSetWidescreen(unsigned extra, unsigned scale) {
+    if (extra > 256 || scale > 8) {
+        return -1;
+    }
+    if (scale == 0) {
+        scale = 1;
+    }
+    if (extra == wide_extra && scale == wide_scale) {
+        return 0;
+    }
+    if (is_platform_init_successful) {
+        Draw_FlushBuffer();
+        for (int i = 0; i < n_canvas; i++) {
+            if (canvas[i].dirty) {
+                SyncCanvasToVram(&canvas[i]);
+            }
+        }
+        DeleteAllCanvases();
+    }
+    wide_extra = extra;
+    wide_scale = scale;
+    if (is_platform_init_successful) {
+        UpdateScissor();
+    }
+    return 0;
+}
+
+unsigned Psyz_VideoGetWidescreen(void) { return wide_extra; }
+
+static GLuint ActiveCanvasFbo(void) { return canvas[active_canvas].fbo; }
+static void SetActiveCanvasViewport(void) {
+    SetCanvasViewport(&canvas[active_canvas]);
+}
+
+
+// ---- indexed images (native map backgrounds) --------------------------------
+// A whole background as one texture of palette indices (R = index, A = 0 for
+// a pixel with no image, drawn black), looked up in a CLUT of the VRAM like
+// an 8-bit texture page: the game's day/night palette changes still apply.
+// It is drawn in ordering-table order (the game queues an application GP0
+// command) at any size, so a background wider than the VRAM tile ring, or
+// with more pixels than the PS1 had, can be shown.
+#define MAX_INDEXED 2
+static struct {
+    GLuint tex;
+    int w, h;
+} indexed[MAX_INDEXED];
+static GLuint idx_program = 0;
+static GLint idx_u_clut = -1;
+static const char idx_fragment_body[] = {
+    "VARY vec2 vUV;\n"
+    "uniform sampler2D texVram;\n"
+    "uniform sampler2D texIdx;\n"
+    "uniform vec2 clutPos;\n"
+    "void main() {\n"
+    "    vec4 p = TEX2D(texIdx, vUV);\n"
+    "    if (p.a < 0.5) {\n"
+    "        FragColor = vec4(0.0, 0.0, 0.0, 1.0);\n"
+    "        return;\n"
+    "    }\n"
+    "    float i = floor(p.r * 255.0 + 0.5);\n"
+    "    vec4 c = TEX2D(texVram, (clutPos + vec2(i, 0.0) + 0.5) /\n"
+    "                            vec2(1024.0, 512.0));\n"
+    "    if (c.r == 0.0 && c.g == 0.0 && c.b == 0.0 && c.a == 0.0) {\n"
+    "        discard;\n"
+    "    }\n"
+    "    FragColor = vec4(c.rgb, 1.0);\n"
+    "}\n"};
+
+static bool InitIndexed(void) {
+    if (idx_program) {
+        return true;
+    }
+    if (!InitQuad()) {
+        return false;
+    }
+#if defined(__vita__)
+    GLuint vs = Init_CompileShaderWith(
+        float_prologue_vs_vita, quad_vertex_body, GL_VERTEX_SHADER);
+    GLuint fs = Init_CompileShaderWith(
+        float_prologue_fs_vita, idx_fragment_body, GL_FRAGMENT_SHADER);
+#else
+    GLuint vs = Init_CompileShaderWith(
+        float_prologue_vs_core, quad_vertex_body, GL_VERTEX_SHADER);
+    GLuint fs = Init_CompileShaderWith(
+        float_prologue_fs_core, idx_fragment_body, GL_FRAGMENT_SHADER);
+#endif
+    GLuint program = glCreateProgram();
+    glAttachShader(program, vs);
+    glAttachShader(program, fs);
+    glBindAttribLocation(program, 0, "pos");
+    glBindAttribLocation(program, 1, "uv");
+    glLinkProgram(program);
+    glDeleteShader(vs);
+    glDeleteShader(fs);
+    int success = 0;
+    glGetProgramiv(program, GL_LINK_STATUS, &success);
+    if (!success) {
+        ERRORF("indexed image shader failed to link");
+        glDeleteProgram(program);
+        return false;
+    }
+    glUseProgram(program);
+    glUniform1i(glGetUniformLocation(program, "texVram"), 0);
+    glUniform1i(glGetUniformLocation(program, "texIdx"), 1);
+    idx_u_clut = glGetUniformLocation(program, "clutPos");
+    glUseProgram(shader_program);
+    idx_program = program;
+    return true;
+}
+
+int Psyz_VideoSetIndexedImage(
+    unsigned slot, unsigned w, unsigned h, const unsigned char* rgba) {
+    if (slot >= MAX_INDEXED || !InitPlatform()) {
+        return -1;
+    }
+    if (indexed[slot].tex) {
+        glDeleteTextures(1, &indexed[slot].tex);
+        indexed[slot].tex = 0;
+    }
+    if (!rgba || !w || !h) {
+        return 0;
+    }
+    if (!InitIndexed()) {
+        return -1;
+    }
+    glGenTextures(1, &indexed[slot].tex);
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, indexed[slot].tex);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, (GLsizei)w, (GLsizei)h, 0,
+                 GL_RGBA, GL_UNSIGNED_BYTE, rgba);
+    glBindTexture(GL_TEXTURE_2D, vram_texture);
+    indexed[slot].w = (int)w;
+    indexed[slot].h = (int)h;
+    return 0;
+}
+
+int Psyz_VideoDrawIndexedImage(
+    unsigned slot, int x, int y, int w, int h, unsigned clut) {
+    if (slot >= MAX_INDEXED || !indexed[slot].tex || !InitIndexed()) {
+        return -1;
+    }
+    Draw_FlushBuffer(); // keep the ordering-table order
+    SyncCanvasesSampled();
+
+    // VRAM coordinates, like the vertex shader: position plus draw offset
+    float ox = 0, oy = 0;
+    if (active_canvas >= 0) {
+        CanvasOrigin(&canvas[active_canvas], &ox, &oy);
+    }
+    float x0 = (float)(x + draw_offset.x) - ox;
+    float y0 = (float)(y + draw_offset.y) - oy;
+    float x1 = x0 + (float)w, y1 = y0 + (float)h;
+    float q[16] = {x0, y0, 0.0f, 0.0f, x1, y0, 1.0f, 0.0f,
+                   x0, y1, 0.0f, 1.0f, x1, y1, 1.0f, 1.0f};
+    for (int i = 0; i < 16; i += 4) {
+        q[i] = q[i] / (VRAM_W / 2.0f) - 1.0f;
+        q[i + 1] = q[i + 1] / (VRAM_H / 2.0f) - 1.0f;
+    }
+    if (active_canvas >= 0) {
+        SetActiveCanvasViewport();
+        canvas[active_canvas].dirty = true;
+    } else {
+        glViewport(0, 0, VRAM_W * internal_res, VRAM_H * internal_res);
+    }
+    glDisable(GL_BLEND);
+    glUseProgram(idx_program);
+    glUniform2f(idx_u_clut, (float)((clut & 63) * 16), (float)(clut >> 6));
+    glActiveTexture(GL_TEXTURE1);
+    glBindTexture(GL_TEXTURE_2D, indexed[slot].tex);
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, vram_texture);
+#if defined(__vita__)
+    glBindVertexArray(0);
+    glBindBuffer(GL_ARRAY_BUFFER, 0);
+    glEnableVertexAttribArray(0);
+    glEnableVertexAttribArray(1);
+    glVertexAttribPointer(0, 2, GL_FLOAT, GL_FALSE, 4 * sizeof(float), q);
+    glVertexAttribPointer(1, 2, GL_FLOAT, GL_FALSE, 4 * sizeof(float), q + 2);
+    glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+    glDisableVertexAttribArray(0);
+    glDisableVertexAttribArray(1);
+#else
+    glBindVertexArray(quad_vao);
+    glBindBuffer(GL_ARRAY_BUFFER, quad_vbo);
+    glBufferData(GL_ARRAY_BUFFER, sizeof(q), q, GL_STREAM_DRAW);
+    glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);
+    glBindVertexArray(0);
+#endif
+    glActiveTexture(GL_TEXTURE1);
+    glBindTexture(GL_TEXTURE_2D, 0);
+    glActiveTexture(GL_TEXTURE0);
+    glEnable(GL_BLEND);
+    glUseProgram(shader_program);
+    return 0;
+}
+
+
+// ---- external movies --------------------------------------------------------
+// Psyz_VideoPlayMovie: plays a video file full screen (aspect kept), with its
+// audio, until it ends or skip() says so. The Vita decodes it in hardware
+// (sceAvPlayer, H.264/AAC MP4) and samples its YUV frames directly, as
+// vitaGL's video_playback sample does; elsewhere ffmpeg decodes it through a
+// pipe (a development path).
+
+static void PresentMovieTexture(GLuint tex, int w, int h) {
+    WndSize win;
+#if defined(__vita__)
+    win.w = PSYZ_VITA_SCREEN_W;
+    win.h = PSYZ_VITA_SCREEN_H;
+#else
+    SDL_GetWindowSizeInPixels(sdl3_window, &win.w, &win.h);
+#endif
+    SDL_Rect dst = FitGameToWindow((float)w / (float)h, win);
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    glDisable(GL_SCISSOR_TEST);
+    glViewport(0, 0, win.w, win.h);
+    glClearColor(0, 0, 0, 1);
+    glClear(GL_COLOR_BUFFER_BIT);
+    if (tex) {
+        glViewport(dst.x, dst.y, dst.w, dst.h);
+        // row 0 of a frame is its top line
+        DrawTexQuad(tex, -1.0f, -1.0f, 1.0f, 1.0f, 0.0f, 1.0f, 1.0f, 0.0f);
+    }
+#if defined(__vita__)
+    vglSwapBuffers(GL_FALSE);
+#else
+    SDL_GL_SwapWindow(sdl3_window);
+#endif
+}
+
+static void EndMovie(void) {
+    BindDrawFbo();
+    ApplyScissor();
+    glBindTexture(GL_TEXTURE_2D, vram_texture);
+}
+
+#if defined(__vita__)
+#include <psp2/audioout.h>
+#include <psp2/avplayer.h>
+#include <psp2/gxm.h>
+#include <psp2/io/stat.h>
+#include <psp2/kernel/sysmem.h>
+#include <psp2/kernel/threadmgr.h>
+#include <psp2/sysmodule.h>
+#include <malloc.h>
+
+#define MOVIE_BUFFERS 5
+#define PHYCONT_ALIGN (1024 * 1024)
+
+static void* MovieAllocCpu(void* p, uint32_t align, uint32_t size) {
+    (void)p;
+    return memalign(align, size);
+}
+static void MovieFreeCpu(void* p, void* ptr) {
+    (void)p;
+    free(ptr);
+}
+static void* MovieAllocGpu(void* p, uint32_t align, uint32_t size) {
+    (void)p, (void)align;
+    size = (size + PHYCONT_ALIGN - 1) & ~(PHYCONT_ALIGN - 1);
+    SceUID blk = sceKernelAllocMemBlock(
+        "dw1_movie", SCE_KERNEL_MEMBLOCK_TYPE_USER_MAIN_PHYCONT_NC_RW, size,
+        NULL);
+    if (blk < 0) {
+        return NULL;
+    }
+    void* res;
+    sceKernelGetMemBlockBase(blk, &res);
+    sceGxmMapMemory(res, size, SCE_GXM_MEMORY_ATTRIB_RW);
+    return res;
+}
+static void MovieFreeGpu(void* p, void* addr) {
+    (void)p;
+    glFinish(); // the GPU may still sample it
+    SceUID blk = sceKernelFindMemBlockByAddr(addr, 0);
+    sceGxmUnmapMemory(addr);
+    sceKernelFreeMemBlock(blk);
+}
+
+static SceAvPlayerHandle movie_player;
+static volatile int movie_running;
+
+static int MovieAudioThread(SceSize args, void* argp) {
+    (void)args, (void)argp;
+    int port = sceAudioOutOpenPort(SCE_AUDIO_OUT_PORT_TYPE_BGM, 1024, 48000,
+                                   SCE_AUDIO_OUT_MODE_STEREO);
+    while (movie_running) {
+        SceAvPlayerFrameInfo frame;
+        if (sceAvPlayerIsActive(movie_player) &&
+            sceAvPlayerGetAudioData(movie_player, &frame)) {
+            sceAudioOutSetConfig(
+                port, 1024, frame.details.audio.sampleRate,
+                frame.details.audio.channelCount == 1
+                    ? SCE_AUDIO_OUT_MODE_MONO
+                    : SCE_AUDIO_OUT_MODE_STEREO);
+            sceAudioOutOutput(port, frame.pData);
+        } else {
+            sceKernelDelayThread(1000);
+        }
+    }
+    if (port >= 0) {
+        sceAudioOutReleasePort(port);
+    }
+    return sceKernelExitDeleteThread(0);
+}
+
+int Psyz_VideoPlayMovie(const char* path, int (*skip)(void)) {
+    SceIoStat st;
+    if (sceIoGetstat(path, &st) < 0 || !InitPlatform() || !InitQuad()) {
+        return -1;
+    }
+    Draw_FlushBuffer();
+    sceSysmoduleLoadModule(SCE_SYSMODULE_AVPLAYER);
+    SceAvPlayerInitData init;
+    memset(&init, 0, sizeof(init));
+    init.memoryReplacement.allocate = MovieAllocCpu;
+    init.memoryReplacement.deallocate = MovieFreeCpu;
+    init.memoryReplacement.allocateTexture = MovieAllocGpu;
+    init.memoryReplacement.deallocateTexture = MovieFreeGpu;
+    init.basePriority = 0xA0;
+    init.numOutputVideoFrameBuffers = MOVIE_BUFFERS;
+    init.autoStart = GL_TRUE;
+    movie_player = sceAvPlayerInit(&init);
+    if (!movie_player) {
+        ERRORF("sceAvPlayerInit failed");
+        return -1;
+    }
+    // textures whose data pointer becomes each decoded frame
+    GLuint tex[MOVIE_BUFFERS];
+    SceGxmTexture* gxm_tex[MOVIE_BUFFERS];
+    glGenTextures(MOVIE_BUFFERS, tex);
+    for (int i = 0; i < MOVIE_BUFFERS; i++) {
+        glBindTexture(GL_TEXTURE_2D, tex[i]);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, 8, 8, 0, GL_RGBA,
+                     GL_UNSIGNED_BYTE, NULL);
+        gxm_tex[i] = vglGetGxmTexture(GL_TEXTURE_2D);
+        vglFree(vglGetTexDataPointer(GL_TEXTURE_2D));
+    }
+    movie_running = 1;
+    SceUID audio = sceKernelCreateThread("dw1_movie_audio", MovieAudioThread,
+                                         0x10000100 - 10, 0x4000, 0, 0, NULL);
+    sceKernelStartThread(audio, 0, NULL);
+    int added = sceAvPlayerAddSource(movie_player, path);
+    INFOF("movie: playing %s (add source %d)", path, added);
+
+    int idx = 0, shown = 0, result = 1, w = 960, h = 544;
+    Uint64 started = SDL_GetTicks();
+    for (;;) {
+        SDL_PumpEvents();
+        if (!shown && SDL_GetTicks() - started > 5000) {
+            // sceAvPlayer never started (memory, unsupported stream): the
+            // game plays its own movie instead of waiting on a black screen
+            ERRORF("movie: no frame from %s after 5 s, giving up", path);
+            result = -1;
+            break;
+        }
+        if (skip && skip()) {
+            result = 0;
+            break;
+        }
+        if (sceAvPlayerIsActive(movie_player)) {
+            SceAvPlayerFrameInfo frame;
+            if (sceAvPlayerGetVideoData(movie_player, &frame)) {
+                idx = (idx + 1) % MOVIE_BUFFERS;
+                w = frame.details.video.width;
+                h = frame.details.video.height;
+                sceGxmTextureInitLinear(gxm_tex[idx], frame.pData,
+                                        SCE_GXM_TEXTURE_FORMAT_YVU420P2_CSC1,
+                                        w, h, 0);
+                sceGxmTextureSetMinFilter(
+                    gxm_tex[idx], SCE_GXM_TEXTURE_FILTER_LINEAR);
+                sceGxmTextureSetMagFilter(
+                    gxm_tex[idx], SCE_GXM_TEXTURE_FILTER_LINEAR);
+                shown = 1;
+            }
