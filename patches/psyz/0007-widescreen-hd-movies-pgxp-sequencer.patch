+// ---- PGXP: sub-pixel screen positions and depth for the renderer ---------
+// The PS1 GTE hands out whole-pixel screen coordinates and no depth, so 3D
+// polygons wobble as the camera moves and their textures warp (affine
+// mapping). Like the PGXP of PS1 emulators, each projection also stores the
+// exact x,y and the view depth, under the integer x,y that the game gets and
+// later writes into its primitives.
+//
+// Small models put several vertices on one pixel, so a pixel keeps up to
+// PGXP_CANDS different ones, each with the sequence numbers of the
+// projections that gave it (a vertex shared by several polygons is projected
+// again for each of them). A polygon takes, for each of its vertices, the
+// candidate projected closest in sequence to the others: the vertices of one
+// polygon go through the GTE together (RTPT, RotTransPers3/4). When a pixel
+// overflows or the best fit is too far apart, the renderer draws that
+// polygon the PS1 way.
+#define PGXP_SLOTS 16384 // power of two
+#define PGXP_PROBES 16
+#define PGXP_CANDS 8
+#define PGXP_MAX_SPAN 4096 // projections between the vertices of a polygon
+typedef struct {
+    float x, y, w;
+    unsigned first, last; // sequence numbers of the projections
+} PgxpVertex;
+typedef struct {
+    unsigned key; // packed SXY
+    unsigned gen; // frame that wrote it
+    int n;        // candidates, -1 after an overflow
+    PgxpVertex v[PGXP_CANDS];
+} PgxpEntry;
+static PgxpEntry pgxp_cache[PGXP_SLOTS];
+static unsigned pgxp_gen = 2; // entries start at gen 0: never valid
+static unsigned pgxp_seq;
+static int pgxp_on;
+
+void Psyz_PgxpSetEnabled(int on) { pgxp_on = on != 0; }
+int Psyz_PgxpIsEnabled(void) { return pgxp_on; }
+void Psyz_PgxpNextFrame(void) { pgxp_gen++; }
+
+static inline unsigned pgxp_slot(unsigned key) {
+    return (key * 2654435761u) >> 18; // 14 bits
+}
+
+// x,y,z the model vertex (V0..V2), sx,sy the GTE's integer result
+static void pgxp_store(int x, int y, int z, int sx, int sy) {
+    float fx = (float)M.t[0] + ((float)M.m[0][0] * x + (float)M.m[0][1] * y +
+                                (float)M.m[0][2] * z) *
+                                   (1.0f / 4096.0f);
+    float fy = (float)M.t[1] + ((float)M.m[1][0] * x + (float)M.m[1][1] * y +
+                                (float)M.m[1][2] * z) *
+                                   (1.0f / 4096.0f);
+    float fz = (float)M.t[2] + ((float)M.m[2][0] * x + (float)M.m[2][1] * y +
+                                (float)M.m[2][2] * z) *
+                                   (1.0f / 4096.0f);
+    float px, py, dx, dy;
+    unsigned key, i, seq = ++pgxp_seq;
+    int n, k;
+    // the GTE divider saturates there: keep the PS1 result
+    if (fz * 2.0f <= (float)H || fz >= 65536.0f) {
+        return;
+    }
+    // the GTE truncates, so sx is about px rounded down: centre it on sx
+    px = (float)OFX + (float)H * fx / fz - 0.5f;
+    py = (float)OFY + (float)H * fy / fz - 0.5f;
+    dx = px - (float)sx;
+    dy = py - (float)sy;
+    if (dx < -1.0f || dx > 1.0f || dy < -1.0f || dy > 1.0f) {
+        return; // clamped to the GTE's screen range
+    }
+    key = SXY(sx, sy);
+    i = pgxp_slot(key);
+    for (n = 0; n < PGXP_PROBES; n++, i = (i + 1) & (PGXP_SLOTS - 1)) {
+        PgxpEntry* e = &pgxp_cache[i];
+        if (e->gen != pgxp_gen) {
+            e->key = key;
+            e->gen = pgxp_gen;
+            e->n = 0;
+        } else if (e->key != key) {
+            continue;
+        }
+        for (k = 0; k < e->n; k++) {
+            // the same vertex again gives the same values
+            PgxpVertex* v = &e->v[k];
+            float ex = v->x - px, ey = v->y - py, ew = v->w - fz;
+            if (ex > -0.01f && ex < 0.01f && ey > -0.01f && ey < 0.01f &&
+                ew > -0.001f * fz && ew < 0.001f * fz) {
+                v->last = seq;
+                return;
+            }
+        }
+        if (e->n < 0) {
+            return;
+        }
+        if (e->n == PGXP_CANDS) {
+            e->n = -1;
+            return;
+        }
+        e->v[e->n].x = px;
+        e->v[e->n].y = py;
+        e->v[e->n].w = fz;
+        e->v[e->n].first = seq;
+        e->v[e->n].last = seq;
+        e->n++;
+        return;
+    }
+}
+
+static const PgxpEntry* pgxp_find(int sx, int sy) {
+    unsigned key = SXY(sx, sy), i = pgxp_slot(key);
+    int n;
+    for (n = 0; n < PGXP_PROBES; n++, i = (i + 1) & (PGXP_SLOTS - 1)) {
+        const PgxpEntry* e = &pgxp_cache[i];
+        if (e->key == key && pgxp_gen - e->gen <= 1u) {
+            return e->n > 0 ? e : NULL;
+        }
+    }
+    return NULL;
+}
+
+// projections between two candidates (0 when their ranges overlap)
+static unsigned pgxp_gap(const PgxpVertex* a, const PgxpVertex* b) {
+    if (b->last < a->first) {
+        return a->first - b->last;
+    }
+    if (a->last < b->first) {
+        return b->first - a->last;
+    }
+    return 0;
+}
+
+int Psyz_PgxpLookupPolygon(int n, const short* sx, const short* sy,
+                           float (*out)[4]) {
+    const PgxpEntry* e[PGXP_MAX_POLY];
+    const PgxpVertex* pick[PGXP_MAX_POLY];
+    unsigned best = PGXP_MAX_SPAN + 1;
+    float best_dw = 0.0f;
+    int i, a, k;
+    if (n > PGXP_MAX_POLY) {
+        return 0;
+    }
+    for (i = 0; i < n; i++) {
+        if ((e[i] = pgxp_find(sx[i], sy[i])) == NULL) {
+            return 0;
+        }
+    }
+    // anchor on each candidate of the first vertex, take the closest
+    // candidate of every other vertex; nearest depth breaks ties
+    for (a = 0; a < e[0]->n; a++) {
+        const PgxpVertex* anchor = &e[0]->v[a];
+        const PgxpVertex* cur[PGXP_MAX_POLY];
+        unsigned span = 0;
+        float dw = 0.0f;
+        cur[0] = anchor;
+        for (i = 1; i < n; i++) {
+            unsigned g = ~0u;
+            float gw = 0.0f;
+            for (k = 0; k < e[i]->n; k++) {
+                const PgxpVertex* c = &e[i]->v[k];
+                unsigned gk = pgxp_gap(anchor, c);
+                float wk = c->w > anchor->w ? c->w - anchor->w
+                                            : anchor->w - c->w;
+                if (gk < g || (gk == g && wk < gw)) {
+                    g = gk;
+                    gw = wk;
+                    cur[i] = c;
+                }
+            }
+            span = g > span ? g : span;
+            dw += gw;
+        }
+        if (span < best || (span == best && dw < best_dw)) {
+            best = span;
+            best_dw = dw;
+            for (i = 0; i < n; i++) {
+                pick[i] = cur[i];
+            }
+        }
+    }
+    if (best > PGXP_MAX_SPAN) {
+        return 0;
+    }
+    for (i = 0; i < n; i++) {
+        out[i][0] = pick[i]->x;
+        out[i][1] = pick[i]->y;
+        out[i][2] = pick[i]->w;
+        out[i][3] = 1.0f;
+    }
+    return 1;
+}
