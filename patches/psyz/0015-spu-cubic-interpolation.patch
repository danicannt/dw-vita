spu: optional Catmull-Rom voice interpolation

Psyz_SpuSetInterp(PSYZ_SPU_INTERP_GAUSS | PSYZ_SPU_INTERP_CUBIC) swaps the
4-tap weight table used by spu_voice_step; gauss (the console table) stays
the default. If nobody calls it, the first pull reads PSYZ_SPU_INTERP.

--- a/psyz/src/psyz/spu_voice.h	2026-10-29 18:37:34.393736537 +0100
+++ b/psyz/src/psyz/spu_voice.h	2026-10-29 18:27:59.772226073 +0100
@@ -6,6 +6,32 @@
 #include "../../decomp/src/libspu/libspu_private.h"
 #include "spu_gauss.h"
 
+// Voice interpolation weights, 256 phases x 4 taps, oldest sample first, Q15.
+// Gauss is the table measured on the console (default); Catmull-Rom keeps
+// more of the 4-16 kHz band at the same cost (PSYZ_SPU_INTERP=cubic).
+static short spu_cubic_tbl[1024];
+static const short* spu_interp_tbl = spu_gauss_tbl;
+
+static inline short spu_q15(double w) {
+    int q = (int)(w * 32768.0 + (w < 0 ? -0.5 : 0.5));
+    return q > 32767 ? 32767 : q < -32768 ? -32768 : q;
+}
+
+static inline void spu_voice_set_interp(int mode) {
+    if (mode != PSYZ_SPU_INTERP_CUBIC) {
+        spu_interp_tbl = spu_gauss_tbl;
+        return;
+    }
+    for (int p = 0; p < 256; p++) {
+        double t = p / 256.0, t2 = t * t, t3 = t2 * t;
+        spu_cubic_tbl[p * 4 + 0] = spu_q15(0.5 * (-t3 + 2 * t2 - t));
+        spu_cubic_tbl[p * 4 + 1] = spu_q15(0.5 * (3 * t3 - 5 * t2 + 2));
+        spu_cubic_tbl[p * 4 + 2] = spu_q15(0.5 * (-3 * t3 + 4 * t2 + t));
+        spu_cubic_tbl[p * 4 + 3] = spu_q15(0.5 * (t3 - t2));
+    }
+    spu_interp_tbl = spu_cubic_tbl;
+}
+
 // One ADPCM block decodes to 28 samples
