diff --git a/decomp/src/libsnd/ut_ako.c b/decomp/src/libsnd/ut_ako.c
index 08c315f..540837a 100644
--- a/decomp/src/libsnd/ut_ako.c
+++ b/decomp/src/libsnd/ut_ako.c
@@ -1,4 +1,16 @@
 #include "libsnd_private.h"
+#ifdef __psyz
+// The PS1 ran SsSeqCalledTbyT (the sound tick) as an interrupt, so these never
+// found _snd_ev_flag set by it. In PSY-Z the tick runs on the IRQ thread under
+// the kernel lock: without taking it too, a key off that met the tick halfway
+// returned -1 and the voice played on (a looping sound kept over the next map).
+// Each public entry point below runs its PS1 body under that lock.
+void PS1_EnterCriticalSection(void);
+void PS1_ExitCriticalSection(void);
+#endif
+#ifdef __psyz
+#define SsUtAllKeyOff SsUtAllKeyOff_ps1
+#endif
 
 void SsUtAllKeyOff(short mode) {
     short i;
@@ -20,3 +32,14 @@ void SsUtAllKeyOff(short mode) {
         _SsVmKeyOffNow(1);
     }
 }
+
+#ifdef __psyz
+#undef SsUtAllKeyOff
+void SsUtAllKeyOff_ps1(short mode);
+
+void SsUtAllKeyOff(short mode) {
+    PS1_EnterCriticalSection();
+    SsUtAllKeyOff_ps1(mode);
+    PS1_ExitCriticalSection();
+}
+#endif
